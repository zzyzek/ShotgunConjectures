/-
AMR-froberg-P (Froberg, Lundqvist, Oneto, Shapiro 2018, Problem P).
psi(f) = sum_{a in F_p} f(a) x^a on polynomials of degree < p over F_p.
In the basis 1, x, ..., x^(p-1) psi has matrix Psi[a][j] = a^j mod p (0^0 = 1),
`psiMat p` below.

Generated by certificate/gen_lean.py. For each (p, n) with
  (3, 8), (5, 124), (7, 1368), (11, 32129475)
and each exponent e in {n} ∪ {n / q : q in the listed primes of n}:
  * `<c>_bits_val`: the bit list is the binary expansion of e without its
    leading 1 (bitsVal 1 bits = e);
  * `<c>_sqK`: s_K = m_{K-1}^2 mod p, and if bit K is true `<c>_mulK`:
    m_K = s_K * psiMat p mod p (else m_K = s_K), with m_0 = psiMat p.
    Matrices are stored as Nat codes (`decodeMat`, `encodeMat`, base-16
    digits); a step is checked as encodeMat (mulMat p (decodeMat p X)
    (decodeMat p Y)) = Z; `c<p>_code0_ok` checks decodeMat p code_0 = psiMat p;
  * `<c>_identity` (e = n): decodeMat of the last code is the identity matrix;
  * `<c>_not_identity` (e = n / q): decodeMat of the last code is not the identity;
  * `c<p>_factors`: the listed q are prime (trial division up to sqrt q) and
    n is a product of powers of them.
Checked by kernel evaluation (`decide +kernel`).
Not checked in Lean:
  * the chain gives m_last = Psi^e; this is induction on K using
    associativity of matrix multiplication mod p (m_K = Psi^(e_K) with
    e_K = 2 e_{K-1} + bit_K);
  * `primeB q = true` means q is prime (standard trial-division argument);
  * the group step: Psi^n = I and Psi^(n/q) /= I for every prime q | n imply
    that n is the least positive i with Psi^i = I.
-/

def dotMod (p : Nat) (r c : List Nat) : Nat :=
  (List.zipWith (· * ·) r c).foldl (· + ·) 0 % p

def addMod (p : Nat) : List Nat → List Nat → List Nat
  | x :: xs, y :: ys => ((x + y) % p) :: addMod p xs ys
  | _, _ => []

def scaleMod (p c : Nat) (v : List Nat) : List Nat := v.map (fun y => c * y % p)

-- Row i of A*B as the combination sum_k A[i][k] * (row k of B), mod p.
--
def rowComb (p : Nat) : List Nat → List (List Nat) → List Nat → List Nat
  | c :: cs, b :: bs, acc => rowComb p cs bs (addMod p acc (scaleMod p c b))
  | _, _, acc => acc

def mulMat (p : Nat) (A B : List (List Nat)) : List (List Nat) :=
  A.map (fun r => rowComb p r B (List.replicate B.length 0))

def identMat (n : Nat) : List (List Nat) :=
  (List.range n).map (fun i => (List.range n).map (fun j => if i = j then 1 else 0))

def psiMat (p : Nat) : List (List Nat) :=
  (List.range p).map (fun a => (List.range p).map (fun j => a ^ j % p))

-- Matrices are stored as one Nat: entry (i, j) of a d x d matrix is the
-- base-16 digit number i*d + j (least significant first).
--
def digitsF : Nat → Nat → List Nat
  | 0, _ => []
  | k + 1, m => (m % 16) :: digitsF k (m / 16)

def rowsF (d : Nat) : Nat → List Nat → List (List Nat)
  | 0, _ => []
  | k + 1, l => l.take d :: rowsF d k (l.drop d)

def decodeMat (d m : Nat) : List (List Nat) := rowsF d d (digitsF (d * d) m)

def encodeMat (A : List (List Nat)) : Nat :=
  A.flatten.foldr (fun x acc => x + 16 * acc) 0


-- Value of a binary expansion read most significant bit first,
-- after a leading prefix value acc.
--
def bitsVal (acc : Nat) : List Bool → Nat
  | [] => acc
  | b :: bs => bitsVal (2 * acc + (if b then 1 else 0)) bs

-- Trial division: true iff q >= 2 and no d with 2 <= d, d*d <= q divides q.
--
def noDivFrom (q : Nat) : Nat → Nat → Bool
  | 0, _ => false
  | f + 1, d => if q < d * d then true else (q % d != 0) && noDivFrom q f (d + 1)

def primeB (q : Nat) : Bool := (2 ≤ q) && noDivFrom q (q + 2) 2

-- Divide out all powers of q from m (fuel bounds the number of divisions).
--
def stripF (q : Nat) : Nat → Nat → Nat
  | 0, m => m
  | f + 1, m => if m % q = 0 ∧ 0 < m then stripF q f (m / q) else m

def stripAll (qs : List Nat) (m : Nat) : Nat :=
  qs.foldl (fun acc q => stripF q 200 acc) m

-- Row 0 of psiMat p is (1, 0, ..., 0): psi keeps the constant term, so the
-- hyperplane {f : f(0) = 0} is psi-invariant (checked for p <= 13 here; the
-- general statement is the one-line argument 0^j = 0 for j >= 1).
--
theorem froberg_P_row0 :
    [3, 5, 7, 11, 13].all (fun p =>
      (psiMat p).head? == some ((List.range p).map (fun j => if j = 0 then 1 else 0))) = true := by
  decide +kernel

