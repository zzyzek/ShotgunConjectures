n=1947793410288108579327587698415272737289992039373107522449638016140636142596276017072442826236838486130285072853813458640948347868163450516845165654669897619318450994951647517899051394662400000000000000000000;
F=factor(n,10^7); print(F); print(#digits(n));
rho(F)=prod(i=1,#F~,my(p=F[i,1],e=F[i,2]); (p^(e+1)+(-1)^e)/(p+1));
print("allprime=",vecmin(apply(isprime,F[,1]~)));
print("n/rho=", n/rho(F));
