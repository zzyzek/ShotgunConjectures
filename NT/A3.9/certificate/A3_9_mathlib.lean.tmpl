import OpenProblemsLib

/-
NT-A3.9 (Mathlib). Guy A3, De Koninck's questions: with p(k) the smallest prime whose decimal
digits sum to k, is p(k) ≡ 9 (mod 10) for k > 25, ≡ 99 (mod 100) for k > 38, and
≡ 999 (mod 1000) for k > 59? README result: the second and third parts are false,
p(86) = 6999999989 ≡ 89 (mod 100), ≡ 989 (mod 1000); further failures p(104) = 699999999989,
p(137) = 3999999999999989; the mod-10 part holds for every 25 < k < 180 (k not a multiple of 3).

Digit sum: `ds n = (Nat.digits 10 n).sum` (Mathlib). p(k) is stated as Mathlib
`IsLeast {p | p.Prime ∧ ds p = k}`.

Main theorems:
* `A3_9_main`: IsLeast {p prime, digit sum 86} 6999999989, and it is 89 mod 100, 989 mod 1000;
  `A3_9_false`: so the second and third parts fail (at k = 86).
* `A3_9_values`: p(104) = 699999999989 and p(137) = 3999999999999989, both 89 mod 100 and
  989 mod 1000.
* `A3_9_mod10`: for every k with 25 < k < 180 and 3 ∤ k, p(k) exists and p(k) ≡ 9 (mod 10).
* `A3_9_mult3`: for k > 3 with 3 ∣ k no prime has digit sum k (so p(k) does not exist).

Proof. `table` lists, for each such k, p(k) and a list of factors. Primality: Pratt
certificate. Minimality: `chkF P P k f` is a kernel-evaluated enumeration of all n < P with
digit sum k, digit by digit from the right, pruned by an upper bound on the digit sums below
a bound (`mbF`); `chkF_spec` proves it sound, and `f = comp fs` checks that each such n has a
proper factor in fs. The table data (p(k), factors) is computed outside by
certificate/a39_lean_gen.py and checked here by the kernel.

Outside Lean: nothing for the stated range. The mod-10 question for k ≥ 180 is open (README).
(Generated by certificate/a39_lean_gen.py from certificate/A3_9_mathlib.lean.tmpl.)
-/

open OpenProblemsLib

/-- Pratt certificate for every p(k) in `table` (tools/pratt_cert.py). -/
def cert : List PrattStep :=
  @CERT

/-- Decimal digit sum (Mathlib digits). -/
abbrev ds (n : ℕ) : ℕ := (Nat.digits 10 n).sum

theorem ds_step (x d : ℕ) (hd : d < 10) : ds (10 * x + d) = d + ds x := by
  rcases Nat.eq_zero_or_pos (10 * x + d) with h0 | hpos
  · have hx : x = 0 := by omega
    have hd0 : d = 0 := by omega
    subst hx; subst hd0; simp
  · unfold ds
    rw [Nat.digits_def' (by norm_num) hpos]
    simp only [List.sum_cons]
    congr 2
    · omega
    · congr 1; omega

theorem ds_le_self (n : ℕ) : ds n ≤ n := Nat.digit_sum_le 10 n

/-- Digit sum with fuel, stopping at 0. -/
def dsF : ℕ → ℕ → ℕ
  | 0, _ => 0
  | k + 1, x => if x = 0 then 0 else x % 10 + dsF k (x / 10)

theorem dsF_eq : ∀ k x, x ≤ k → dsF k x = ds x
  | 0, x, h => by simp at h; subst h; simp [dsF, ds]
  | k + 1, x, h => by
    unfold dsF
    split_ifs with hx
    · subst hx; simp [ds]
    · rw [dsF_eq k (x / 10) (by omega)]
      have e : x = 10 * (x / 10) + x % 10 := by omega
      conv_rhs => rw [e, ds_step _ _ (Nat.mod_lt _ (by norm_num))]

def dsC (x : ℕ) : ℕ := dsF x x

theorem dsC_eq (x : ℕ) : dsC x = ds x := dsF_eq x x le_rfl

/-- One more than the largest digit sum of a number below P (0 if P = 0); fuel ≥ P. -/
def mbF : ℕ → ℕ → ℕ
  | 0, P => P
  | g + 1, P => if P = 0 then 0 else
      max (if P / 10 = 0 then 0 else mbF g (P / 10) + 9) (if P % 10 = 0 then 0 else dsC (P / 10) + P % 10)

theorem mbF_spec : ∀ g P n, n < P → ds n + 1 ≤ mbF g P
  | 0, P, n, h => by simp only [mbF]; have := ds_le_self n; omega
  | g + 1, P, n, h => by
    unfold mbF
    have hP : P ≠ 0 := by omega
    simp only [hP, ite_false]
    have e : n = 10 * (n / 10) + n % 10 := by omega
    have hs : ds n = n % 10 + ds (n / 10) := by
      conv_lhs => rw [e]
      exact ds_step _ _ (Nat.mod_lt _ (by norm_num))
    rcases Nat.lt_or_ge (n / 10) (P / 10) with h1 | h1
    · have := mbF_spec g (P / 10) (n / 10) h1
      have hq : P / 10 ≠ 0 := by omega
      simp only [hq, ite_false]
      have : n % 10 < 10 := Nat.mod_lt _ (by norm_num)
      omega
    · have hm : n / 10 = P / 10 := by omega
      have hd : n % 10 < P % 10 := by omega
      have hr : P % 10 ≠ 0 := by omega
      simp only [hr, ite_false, dsC_eq]
      rw [hm] at hs
      omega

def mb (P : ℕ) : ℕ := mbF P P

/-- Every n < P with digit sum k satisfies f. -/
def chkF : ℕ → ℕ → ℕ → (ℕ → Bool) → Bool
  | 0, _, _, _ => false
  | g + 1, P, k, f => decide (mb P ≤ k) ||
      ((List.range 10).all (fun d => decide (k < d) || chkF g (P / 10) (k - d) (fun m => f (10 * m + d))) &&
       (List.range (P % 10)).all (fun d => dsC (P / 10) + d != k || f (10 * (P / 10) + d)))

theorem chkF_spec : ∀ g P k f, chkF g P k f = true → ∀ n < P, ds n = k → f n = true
  | 0, _, _, _, h, _, _, _ => by simp [chkF] at h
  | g + 1, P, k, f, h, n, hn, hk => by
    simp only [chkF, Bool.or_eq_true, decide_eq_true_eq, Bool.and_eq_true, List.all_eq_true,
      List.mem_range, bne_iff_ne, ne_eq] at h
    rcases h with h | ⟨h1, h2⟩
    · have := mbF_spec P P n hn; unfold mb at h; omega
    · have e : n = 10 * (n / 10) + n % 10 := by omega
      have hd10 : n % 10 < 10 := Nat.mod_lt _ (by norm_num)
      have hs : ds n = n % 10 + ds (n / 10) := by
        conv_lhs => rw [e]
        exact ds_step _ _ hd10
      rcases Nat.lt_or_ge (n / 10) (P / 10) with hlt | hge
      · rcases h1 (n % 10) hd10 with h' | h'
        · omega
        · have := chkF_spec g (P / 10) (k - n % 10) _ h' (n / 10) hlt (by omega)
          rw [e]; exact this
      · have hm : n / 10 = P / 10 := by omega
        have hd : n % 10 < P % 10 := by omega
        rcases Classical.em (dsC (P / 10) + n % 10 = k) with hc | hc
        · have := h2 (n % 10) hd
          simp only [hc, not_true_eq_false, false_or] at this
          rw [e, hm]; exact this
        · rw [dsC_eq, ← hm] at hc; omega

/-- n has a proper factor in the list. -/
def comp (fs : List ℕ) (n : ℕ) : Bool := fs.any (fun p => 1 < p && p < n && n % p == 0)

theorem not_prime_of_comp (fs : List ℕ) (n : ℕ) (h : comp fs n = true) : ¬ n.Prime := by
  simp only [comp, List.any_eq_true, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
  obtain ⟨p, _, ⟨h1, h2⟩, h3⟩ := h
  exact Nat.not_prime_of_dvd_of_lt (Nat.dvd_of_mod_eq_zero h3) h1 h2

theorem least_of (k P : ℕ) (fs : List ℕ) (hP : P.Prime) (hds : dsC P = k)
    (hchk : chkF P P k (comp fs) = true) : IsLeast {p : ℕ | p.Prime ∧ ds p = k} P := by
  refine ⟨⟨hP, by rw [← dsC_eq]; exact hds⟩, ?_⟩
  rintro n ⟨hn, hnk⟩
  by_contra hlt
  push Not at hlt
  exact not_prime_of_comp fs n (chkF_spec P P k _ hchk n hlt hnk) hn

/-- (k, p(k), factors of the smaller numbers with digit sum k). -/
def table : List (ℕ × ℕ × List ℕ) :=
  [@TABLE]

theorem table_primes : ∀ e ∈ table, e.2.1.Prime := by
  have h := primes_of_prattCertifiesAll (table.map (fun e => e.2.1)) cert (by decide +kernel)
  intro e he
  exact h _ (List.mem_map_of_mem he)

theorem table_ok : table.all (fun e => dsC e.2.1 == e.1 && chkF e.2.1 e.2.1 e.1 (comp e.2.2)) = true := by
  decide +kernel

theorem table_least : ∀ e ∈ table, IsLeast {p : ℕ | p.Prime ∧ ds p = e.1} e.2.1 := by
  intro e he
  have := List.all_eq_true.mp table_ok e he
  simp only [Bool.and_eq_true, beq_iff_eq] at this
  exact least_of e.1 e.2.1 e.2.2 (table_primes e he) this.1 this.2

theorem table_cover : (List.range 180).all (fun k => decide (k ≤ 25) || k % 3 == 0 ||
    table.any (fun e => e.1 == k && e.2.1 % 10 == 9)) = true := by
  decide +kernel

theorem A3_9_mod10 : ∀ k, 25 < k → k < 180 → k % 3 ≠ 0 →
    ∃ p, IsLeast {p : ℕ | p.Prime ∧ (Nat.digits 10 p).sum = k} p ∧ p % 10 = 9 := by
  intro k h1 h2 h3
  have := List.all_eq_true.mp table_cover k (List.mem_range.mpr h2)
  simp only [Bool.or_eq_true, decide_eq_true_eq, beq_iff_eq, List.any_eq_true,
    Bool.and_eq_true] at this
  rcases this with (h | h) | ⟨e, he, hk, h9⟩
  · omega
  · omega
  · refine ⟨e.2.1, ?_, h9⟩
    have := table_least e he
    rw [hk] at this
    exact this

theorem least_in (k P : ℕ) (h : (k, P) ∈ table.map (fun e => (e.1, e.2.1))) :
    IsLeast {p : ℕ | p.Prime ∧ (Nat.digits 10 p).sum = k} P := by
  obtain ⟨e, he, hkP⟩ := List.mem_map.mp h
  simp only [Prod.mk.injEq] at hkP
  rw [← hkP.1, ← hkP.2]
  exact table_least e he

theorem A3_9_main : IsLeast {p : ℕ | p.Prime ∧ (Nat.digits 10 p).sum = 86} 6999999989 ∧
    6999999989 % 100 = 89 ∧ 6999999989 % 1000 = 989 :=
  ⟨least_in 86 6999999989 (by decide +kernel), by norm_num, by norm_num⟩

theorem A3_9_false :
    (¬ ∀ k, 38 < k → ∀ p, IsLeast {p : ℕ | p.Prime ∧ (Nat.digits 10 p).sum = k} p → p % 100 = 99) ∧
    (¬ ∀ k, 59 < k → ∀ p, IsLeast {p : ℕ | p.Prime ∧ (Nat.digits 10 p).sum = k} p → p % 1000 = 999) := by
  obtain ⟨hl, h100, h1000⟩ := A3_9_main
  exact ⟨fun h => by have := h 86 (by norm_num) _ hl; omega,
    fun h => by have := h 86 (by norm_num) _ hl; omega⟩

theorem A3_9_values :
    IsLeast {p : ℕ | p.Prime ∧ (Nat.digits 10 p).sum = 104} 699999999989 ∧
      699999999989 % 100 = 89 ∧ 699999999989 % 1000 = 989 ∧
    IsLeast {p : ℕ | p.Prime ∧ (Nat.digits 10 p).sum = 137} 3999999999999989 ∧
      3999999999999989 % 100 = 89 ∧ 3999999999999989 % 1000 = 989 :=
  ⟨least_in 104 699999999989 (by decide +kernel), by norm_num, by norm_num,
   least_in 137 3999999999999989 (by decide +kernel), by norm_num, by norm_num⟩

theorem A3_9_mult3 : ∀ k, 3 < k → k % 3 = 0 → ¬ ∃ p, p.Prime ∧ (Nat.digits 10 p).sum = k := by
  rintro k hk h3 ⟨p, hp, hs⟩
  have h3p : 3 ∣ p := (Nat.three_dvd_iff p).mpr (by rw [hs]; omega)
  have := (Nat.prime_dvd_prime_iff_eq Nat.prime_three hp).mp h3p
  subst this
  norm_num at hs
  omega
