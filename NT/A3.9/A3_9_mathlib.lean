theorem table_primes : ∀ e ∈ table, e.2.1.Prime := by
  have h := primes_of_prattCertifiesAll (table.map (fun e => e.2.1)) cert (by decide +kernel)
  intro e he
  exact h _ (List.mem_map_of_mem he)

theorem table_ok : table.all (fun e => dsC e.2.1 == e.1 && chkF e.2.1 e.2.1 e.1 (comp e.2.2)) = true := by
  decide +kernel

theorem table_least : ∀ e ∈ table, IsLeast {p : ℕ | p.Prime ∧ ds p = e.1} e.2.1 := by
  intro e he
  have := List.all_eq_true.mp table_ok e he
  simp only [Bool.and_eq_true, beq_iff_eq] at this
  exact least_of e.1 e.2.1 e.2.2 (table_primes e he) this.1 this.2

theorem table_cover : (List.range 180).all (fun k => decide (k ≤ 25) || k % 3 == 0 ||
    table.any (fun e => e.1 == k && e.2.1 % 10 == 9)) = true := by
  decide +kernel

theorem A3_9_mod10 : ∀ k, 25 < k → k < 180 → k % 3 ≠ 0 →
    ∃ p, IsLeast {p : ℕ | p.Prime ∧ (Nat.digits 10 p).sum = k} p ∧ p % 10 = 9 := by
  intro k h1 h2 h3
  have := List.all_eq_true.mp table_cover k (List.mem_range.mpr h2)
  simp only [Bool.or_eq_true, decide_eq_true_eq, beq_iff_eq, List.any_eq_true,
    Bool.and_eq_true] at this
  rcases this with (h | h) | ⟨e, he, hk, h9⟩
  · omega
  · omega
  · refine ⟨e.2.1, ?_, h9⟩
    have := table_least e he
    rw [hk] at this
    exact this

theorem least_in (k P : ℕ) (h : (k, P) ∈ table.map (fun e => (e.1, e.2.1))) :
    IsLeast {p : ℕ | p.Prime ∧ (Nat.digits 10 p).sum = k} P := by
  obtain ⟨e, he, hkP⟩ := List.mem_map.mp h
  simp only [Prod.mk.injEq] at hkP
  rw [← hkP.1, ← hkP.2]
  exact table_least e he

theorem A3_9_main : IsLeast {p : ℕ | p.Prime ∧ (Nat.digits 10 p).sum = 86} 6999999989 ∧
    6999999989 % 100 = 89 ∧ 6999999989 % 1000 = 989 :=
  ⟨least_in 86 6999999989 (by decide +kernel), by norm_num, by norm_num⟩

theorem A3_9_false :
    (¬ ∀ k, 38 < k → ∀ p, IsLeast {p : ℕ | p.Prime ∧ (Nat.digits 10 p).sum = k} p → p % 100 = 99) ∧
    (¬ ∀ k, 59 < k → ∀ p, IsLeast {p : ℕ | p.Prime ∧ (Nat.digits 10 p).sum = k} p → p % 1000 = 999) := by
  obtain ⟨hl, h100, h1000⟩ := A3_9_main
  exact ⟨fun h => by have := h 86 (by norm_num) _ hl; omega,
    fun h => by have := h 86 (by norm_num) _ hl; omega⟩

theorem A3_9_values :
    IsLeast {p : ℕ | p.Prime ∧ (Nat.digits 10 p).sum = 104} 699999999989 ∧
      699999999989 % 100 = 89 ∧ 699999999989 % 1000 = 989 ∧
    IsLeast {p : ℕ | p.Prime ∧ (Nat.digits 10 p).sum = 137} 3999999999999989 ∧
      3999999999999989 % 100 = 89 ∧ 3999999999999989 % 1000 = 989 :=
  ⟨least_in 104 699999999989 (by decide +kernel), by norm_num, by norm_num,
   least_in 137 3999999999999989 (by decide +kernel), by norm_num, by norm_num⟩

theorem A3_9_mult3 : ∀ k, 3 < k → k % 3 = 0 → ¬ ∃ p, p.Prime ∧ (Nat.digits 10 p).sum = k := by
  rintro k hk h3 ⟨p, hp, hs⟩
  have h3p : 3 ∣ p := (Nat.three_dvd_iff p).mpr (by rw [hs]; omega)
  have := (Nat.prime_dvd_prime_iff_eq Nat.prime_three hp).mp h3p
  subst this
  norm_num at hs
  omega
