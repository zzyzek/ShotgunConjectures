def WitOk : Bool :=
  (List.range 1000).all (fun m => m % 2 == 0 || L.contains m ||
    Wit.any (fun e => e.1 == m && okF e.2 && Wf e.2 == (m : ℤ)))

theorem Wit_ok : WitOk = true := by decide +kernel

