theorem L_facts : (L.all (fun m => m < 1000 && m % 2 == 1 &&
    Lf.any (fun e => e.1 == m && 1 < e.2 && e.2 < m + 2 && (m + 2) % e.2 == 0))) = true := by
  decide +kernel

theorem Lz_lt (x : ℤ) (hx : x ∈ Lz) : x < 1000 ∧ ∃ m ∈ L, x = m ∧ m % 2 = 1 ∧ ¬ (m + 2).Prime := by
  obtain ⟨a, ha, hax⟩ := (mem_natsToInts L x).mp hx
  subst hax
  have := List.all_eq_true.mp L_facts a ha
  simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq, List.any_eq_true] at this
  obtain ⟨⟨h1, h2⟩, e, _, ⟨⟨⟨he, hq1⟩, hq2⟩, hq3⟩⟩ := this
  refine ⟨by exact_mod_cast h1, a, ha, rfl, h2, fun hp => ?_⟩
  exact Nat.not_prime_of_dvd_of_lt (Nat.dvd_of_mod_eq_zero hq3) hq1 hq2 hp

/-! ### No n gives a value in L -/

theorem W_not_mem (n : ℕ) (hn : 1 ≤ n) : W n ∉ Lz := by
  intro hmem
  obtain ⟨hlt, m, hmL, hxm, hm2, hmp⟩ := Lz_lt _ hmem
  by_cases hs : n ≤ 2520
  · exact chkS_spec tabS 1 tabS_ok n hn (by rw [tabS_len]; omega) hmem
  push Not at hs
  rcases Nat.even_or_odd n with he | ho
  · -- n even: W(n) ≥ 1000
    have := W_ge n 2 10 Nat.prime_two (even_iff_two_dvd.mp he) (by omega) (by norm_num)
    have : (1000 : ℤ) ≤ W n := by
      have h1 : ((n / 2 : ℕ) : ℤ) - ((10 - 1 + n / 10 : ℕ) : ℤ) + 1 ≥ 1000 := by
        have : n / 2 ≥ 9 + n / 10 + 999 := by omega
        push_cast; omega
      linarith
    linarith
  by_cases hsq : IsSquare n
  · obtain ⟨k, rfl⟩ := hsq
    have hk51 : 51 ≤ k := by nlinarith
    have hko : Odd k := by
      rcases Nat.even_or_odd k with ⟨j, hj⟩ | h
      · exfalso; rw [hj] at ho; exact (Nat.not_even_iff_odd.mpr ho) ⟨j * (2 * j), by ring⟩
      · exact h
    by_cases hkp : k.Prime
    · rw [W_prime_sq k hkp] at hxm
      have : k = m + 2 := by omega
      exact hmp (this ▸ hkp)
    · by_cases hk672 : k < 672
      · have := List.all_eq_true.mp T2_ok k (List.mem_range.mpr hk672)
        have hkod : k % 2 = 1 := Nat.odd_iff.mp hko
        have hptd : primeTD k = false := by
          cases h : primeTD k
          · rfl
          · exact absurd (prime_of_primeTD k h) hkp
        simp only [hptd, Bool.or_false, Bool.or_eq_true, decide_eq_true_eq, beq_iff_eq,
          List.any_eq_true, Bool.and_eq_true, Bool.not_eq_true'] at this
        rcases this with (h | h) | ⟨e, _, ⟨⟨⟨hek, hev⟩, hok⟩, hW⟩⟩
        · omega
        · omega
        · rw [← hev, W_val e.2 hok] at hmem
          exact nmem_of_contains_false hW hmem
      · push Not at hk672
        set p := k.minFac
        have hp : p.Prime := Nat.minFac_prime (by omega)
        have hpk : p ∣ k := Nat.minFac_dvd k
        have hpp : p * p ≤ k := by
          have := Nat.minFac_sq_le_self (by omega : 0 < k) hkp
          rw [sq] at this; exact this
        have hp3 : 3 ≤ p := by
          have h2 := hp.two_le
          rcases Nat.lt_or_ge p 3 with h | h
          · have : p = 2 := by omega
            rw [this] at hpk
            exact absurd (Nat.odd_iff.mp hko) (by have := Nat.mod_eq_zero_of_dvd hpk; omega)
          · exact h
        have hge := W_ge (k * k) p (2 * p) hp (Dvd.dvd.mul_right hpk k) (by nlinarith) (by omega)
        obtain ⟨c, hc⟩ := hpk
        have hA : k * k / p = k * c := by
          rw [hc, show p * c * (p * c) = p * (c * (p * c)) by ring, Nat.mul_div_cancel_left _ hp.pos]
          ring
        have hB : k * k / (2 * p) = (k * c) / 2 := by
          rw [mul_comm 2 p, ← Nat.div_div_eq_div_mul, hA]
        have hcp : p ≤ c := by
          rw [hc] at hpp; exact Nat.le_of_mul_le_mul_left hpp hp.pos
        rw [hA, hB] at hge
        have hkc : k * c ≥ 672 * p := by rw [hc]; nlinarith
        have : (1000 : ℤ) ≤ W (k * k) := by
          have : k * c - (2 * p - 1 + k * c / 2) + 1 ≥ 1000 := by omega
          have h3 : 2 * p - 1 + k * c / 2 ≤ k * c := by omega
          have : ((k * c : ℕ) : ℤ) - ((2 * p - 1 + k * c / 2 : ℕ) : ℤ) + 1 ≥ 1000 := by
            rw [ge_iff_le, ← sub_nonneg]
            have : ((k * c : ℕ) : ℤ) - ((2 * p - 1 + k * c / 2 : ℕ) : ℤ) =
                ((k * c - (2 * p - 1 + k * c / 2) : ℕ) : ℤ) := by rw [Nat.cast_sub h3]
            rw [this]; omega
          linarith
        linarith
  · have hev := W_even n (by omega) hsq ho
    rw [hxm] at hev
    obtain ⟨j, hj⟩ := hev
    omega

theorem B10_3_main : ∀ m : ℕ, m < 1000 → Odd m → (m ∈ L ↔ ∀ n : ℕ, 1 ≤ n → W n ≠ m) := by
  intro m hm ho
  constructor
  · intro hmL n hn hW
    exact W_not_mem n hn (hW ▸ (mem_natsToInts L m).mpr ⟨m, hmL, rfl⟩)
  · intro h
    by_contra hmL
    have := List.all_eq_true.mp Wit_ok m (List.mem_range.mpr hm)
    simp only [Bool.or_eq_true, beq_iff_eq, List.any_eq_true, Bool.and_eq_true] at this
    rcases this with (h1 | h1) | ⟨e, _, ⟨⟨he, hok⟩, hW⟩⟩
    · exact absurd (Nat.odd_iff.mp ho) (by omega)
    · exact hmL (List.contains_iff_mem.mp h1)
    · have hpos := val_pos e.2 (factOK_of_check e.2 (by
        simp only [okF, Bool.and_eq_true] at hok; exact hok.1))
      exact h (val e.2) hpos (by rw [W_val e.2 hok, hW])
