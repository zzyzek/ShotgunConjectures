import OpenProblemsLib

/-
NT-B10.3 (Mathlib). Guy B10 (Meeussen): m < n is unrelated to n if m neither divides n nor is
coprime to it; W(n) = n - d(n) - φ(n) + 1 counts them. Meeussen lists odd numbers
(13, 67, 93, …, 997) and asks whether any of them is a value of W.
README result: none is; the odd non-values of W below 1000 are exactly 86 numbers
13, 67, 93, 123, …, 973, 997 (the list `L` below).

Main theorem `B10_3_main`: for every odd m < 1000, m ∈ L ↔ no n ≥ 1 has W(n) = m, with
W(n) = n - #(Nat.divisors n) - Nat.totient n + 1 in ℤ (Mathlib d and φ).

Proof. (1) n ≤ 2520: W(n) from factorizations (multiplicativity, `OpenProblemsLib.ArithFactor`),
kernel-checked not in L. (2) n > 2520 even: φ(n) ≤ n - n/2 and d(n) ≤ 9 + n/10, so W(n) ≥ 1000.
(3) n odd, not a square: d(n) even (`card_divisors` and parity of the exponents) and φ(n) even,
so W(n) is even. (4) n = k², k prime: W = k - 2 and m + 2 is composite for every m ∈ L.
(5) n = k², k odd composite: k < 672 by kernel-checked factorizations; k ≥ 672: with
p = minFac k (p² ≤ k, p ≥ 3), φ(n) ≤ n - n/p and d(n) ≤ (2p - 1) + n/(2p) give W(n) ≥ 1000.
The other odd m < 1000 have explicit witnesses n (kernel-checked W(n) = m).
The tables are generated by certificate/b103_lean_gen.py and checked by the kernel.

Outside Lean: nothing. The comparison with the book's (partly garbled) printed list is
textual (README).
(Generated by certificate/b103_lean_gen.py from certificate/B10_3_mathlib.lean.tmpl.)
-/

open OpenProblemsLib.ArithFactor

/-- Meeussen's count of numbers below n unrelated to n. -/
def W (n : ℕ) : ℤ := (n : ℤ) - (n.divisors.card : ℤ) - (n.totient : ℤ) + 1

def L : List ℕ := [13, 67, 93, 123, 133, 141, 173, 187, 193, 205, 217, 229, 245, 253, 257, 283, 285, 293, 303, 317, 319, 325, 333, 341, 389, 393, 397, 405, 415, 427, 445, 453, 467, 473, 483, 491, 493, 509, 525, 527, 533, 537, 549, 557, 571, 573, 581, 587, 589, 595, 609, 621, 635, 643, 653, 655, 667, 669, 673, 679, 685, 701, 709, 723, 765, 777, 779, 789, 797, 811, 813, 833, 843, 845, 869, 877, 893, 899, 901, 907, 915, 921, 941, 957, 973, 997]

def natsToInts : List ℕ → List ℤ
  | [] => []
  | a :: r => (a : ℤ) :: natsToInts r

theorem mem_natsToInts (l : List ℕ) (x : ℤ) : x ∈ natsToInts l ↔ ∃ a ∈ l, x = a := by
  induction l with
  | nil => simp [natsToInts]
  | cons a r ih => simp [natsToInts, ih]

def Lz : List ℤ := natsToInts L

def Wf (f : PF) : ℤ := (val f : ℤ) - (ndF f : ℤ) - (phiF f : ℤ) + 1

def okF (f : PF) : Bool := factCheck f && f.all (fun pe => decide (0 < pe.2))

theorem nmem_of_contains_false {l : List ℤ} {x : ℤ} (h : l.contains x = false) : x ∉ l :=
  fun hm => by
    have := List.contains_iff_mem.mpr hm
    rw [h] at this
    exact Bool.false_ne_true this

theorem W_val (f : PF) (h : okF f = true) : W (val f) = Wf f := by
  simp only [okF, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at h
  have hok := factOK_of_check f h.1
  unfold W Wf
  rw [card_divisors_val f hok, totient_val f hok h.2]

/-! ### Bounds on d and φ -/

theorem card_divisors_le (n K : ℕ) (hK : 1 ≤ K) : n.divisors.card ≤ (K - 1) + n / K := by
  rw [← Finset.card_filter_add_card_filter_not (fun d => d < K)]
  apply Nat.add_le_add
  · calc (n.divisors.filter (fun d => d < K)).card ≤ (Finset.Ico 1 K).card := by
          apply Finset.card_le_card
          intro d hd
          rw [Finset.mem_filter] at hd
          exact Finset.mem_Ico.mpr ⟨Nat.pos_of_mem_divisors hd.1, hd.2⟩
      _ = K - 1 := Nat.card_Ico 1 K
  · calc (n.divisors.filter (fun d => ¬ d < K)).card ≤ (Finset.Icc 1 (n / K)).card := by
          apply Finset.card_le_card_of_injOn (fun d => n / d)
          · intro d hd
            simp only [Finset.coe_filter, Set.mem_ofPred_eq, Nat.mem_divisors] at hd
            obtain ⟨⟨hdn, hn0⟩, hdK⟩ := hd
            simp only [Finset.coe_Icc, Set.mem_Icc]
            refine ⟨Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero hn0) hdn)
              (Nat.pos_of_dvd_of_pos hdn (Nat.pos_of_ne_zero hn0)), ?_⟩
            exact Nat.div_le_div_left (by omega) (by omega)
          · intro d₁ h₁ d₂ h₂ he
            simp only [Finset.coe_filter, Set.mem_ofPred_eq, Nat.mem_divisors] at h₁ h₂
            have := congrArg (fun x => n / x) he
            simp only at this
            rwa [Nat.div_div_self h₁.1.1 h₁.1.2, Nat.div_div_self h₂.1.1 h₂.1.2] at this
      _ = n / K := by simp

theorem totient_add_div_le (n p : ℕ) (hp : p.Prime) (hd : p ∣ n) (hn : 1 < n) :
    n.totient + n / p ≤ n := by
  have hsub : (Finset.range n).filter (fun a => n.Coprime a) ⊆
      (Finset.Ioc 0 n).filter (fun a => ¬ p ∣ a) := by
    intro a ha
    simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_Ioc] at ha ⊢
    refine ⟨⟨?_, by omega⟩, fun hpa => ?_⟩
    · rcases Nat.eq_zero_or_pos a with h0 | h0
      · rw [h0, Nat.coprime_zero_right] at ha; omega
      · exact h0
    · have := Nat.Coprime.coprime_dvd_left hd ha.2
      exact (Nat.Prime.coprime_iff_not_dvd hp).mp this hpa
  have hc := Finset.card_filter_add_card_filter_not (s := Finset.Ioc 0 n) (fun a => p ∣ a)
  rw [Nat.Ioc_filter_dvd_card_eq_div, Nat.card_Ioc] at hc
  have := Finset.card_le_card hsub
  rw [← Nat.totient_eq_card_coprime] at this
  omega

theorem W_ge (n p K : ℕ) (hp : p.Prime) (hd : p ∣ n) (hn : 1 < n) (hK : 1 ≤ K) :
    ((n / p : ℕ) : ℤ) - ((K - 1 + n / K : ℕ) : ℤ) + 1 ≤ W n := by
  have h1 := totient_add_div_le n p hp hd hn
  have h2 := card_divisors_le n K hK
  unfold W
  have : (n.totient : ℤ) ≤ n - (n / p : ℕ) := by
    have : n.totient ≤ n - n / p := by omega
    calc (n.totient : ℤ) ≤ ((n - n / p : ℕ) : ℤ) := by exact_mod_cast this
      _ = n - (n / p : ℕ) := by rw [Nat.cast_sub (by omega)]
  have : (n.divisors.card : ℤ) ≤ ((K - 1 + n / K : ℕ) : ℤ) := by exact_mod_cast h2
  linarith

/-! ### Parity -/

theorem even_card_divisors (n : ℕ) (hn : n ≠ 0) (hns : ¬ IsSquare n) :
    Even n.divisors.card := by
  by_contra hodd
  rw [Nat.not_even_iff_odd] at hodd
  rw [Nat.card_divisors hn] at hodd
  have hev : ∀ p ∈ n.primeFactors, Even (n.factorization p) := by
    intro p hp
    by_contra h
    rw [Nat.not_even_iff_odd] at h
    have h2 : 2 ∣ n.factorization p + 1 := by obtain ⟨j, hj⟩ := h; exact ⟨j + 1, by omega⟩
    have := dvd_trans h2 (Finset.dvd_prod_of_mem (fun x => n.factorization x + 1) hp)
    rw [← even_iff_two_dvd] at this
    exact (Nat.not_even_iff_odd.mpr hodd) this
  apply hns
  refine ⟨∏ p ∈ n.primeFactors, p ^ (n.factorization p / 2), ?_⟩
  rw [← Finset.prod_mul_distrib]
  conv_lhs => rw [← Nat.prod_factorization_pow_eq_self hn]
  rw [Finsupp.prod, Nat.support_factorization]
  apply Finset.prod_congr rfl
  intro p hp
  rw [← pow_add]
  congr 1
  obtain ⟨j, hj⟩ := hev p hp
  omega

theorem W_even (n : ℕ) (hn : 2 < n) (hns : ¬ IsSquare n) (ho : Odd n) : Even (W n) := by
  have h1 := even_card_divisors n (by omega) hns
  have h2 := Nat.totient_even hn
  unfold W
  obtain ⟨a, ha⟩ := h1; obtain ⟨b, hb⟩ := h2; obtain ⟨c, hc⟩ := ho
  rw [ha, hb, hc]
  exact ⟨c - a - b + 1, by push_cast; ring⟩

/-! ### Prime squares -/

theorem W_prime_sq (k : ℕ) (hk : k.Prime) : W (k * k) = (k : ℤ) - 2 := by
  have hok : FactOK [(k, 2)] := ⟨by simp, by simpa using hk⟩
  have hv : val [(k, 2)] = k * k := by simp [val]; ring
  unfold W
  rw [← hv, card_divisors_val _ hok, totient_val _ hok (by simp)]
  simp only [val, ndF, phiF]
  have : 1 ≤ k := hk.one_lt.le
  push_cast [Nat.cast_sub this]
  ring

/-! ### Tables -/

/-- Factorizations of n = n₀, n₀ + 1, … -/
def chkS : ℕ → List PF → Bool
  | _, [] => true
  | n, f :: r => (val f == n) && okF f && !(Lz.contains (Wf f)) && chkS (n + 1) r

theorem chkS_spec : ∀ (tab : List PF) (n₀ : ℕ), chkS n₀ tab = true →
    ∀ n, n₀ ≤ n → n < n₀ + tab.length → W n ∉ Lz
  | [], _, _, n, h1, h2 => by simp at h2; omega
  | f :: r, n₀, h, n, h1, h2 => by
    simp only [chkS, Bool.and_eq_true, beq_iff_eq, Bool.not_eq_true'] at h
    obtain ⟨⟨⟨hv, hok⟩, hW⟩, hr⟩ := h
    rcases Nat.eq_or_lt_of_le h1 with he | hlt
    · subst he; rw [← hv, W_val f hok]; exact nmem_of_contains_false hW
    · exact chkS_spec r (n₀ + 1) hr n hlt (by simp at h2; omega)

