import Mathlib

/-
NT-F19.1 (Mathlib). Guy F19 (Recamán): every sufficiently large n has two different partitions
n = a + b + c, 0 < a < b < c, with equal products abc. README result: true for every n ≥ 23;
the exceptions are exactly n ≤ 18 and n = 22. Allowing equal parts (0 < a ≤ b ≤ c), the
exceptions are exactly n ≤ 12, 15 and 18.

Main theorem `F19_1_main`: for every n, `F19_P n ↔ 19 ≤ n ∧ n ≠ 22` and
`F19_Q n ↔ ¬ (n ≤ 12 ∨ n = 15 ∨ n = 18)`, where `F19_P n` (`F19_Q n`) says there are two
different triples with 0 < a < b < c (0 < a ≤ b ≤ c), sum n and equal products.

Proof. n ≥ 23: theorem `F19_recaman` of the core file F19_1.lean, restated here (a two-parameter
family for n ≥ 865 and an explicit table for 23 ≤ n ≤ 864); P implies Q. n ≤ 22: P n and Q n
are equivalent to Bool checks over the list of all partitions of n (`F19_P_iff`, `F19_Q_iff`),
evaluated by `decide`.

Outside Lean: nothing.
-/

/-- `F19_P n`: two different distinct-part partitions of n into 3 parts with equal product. -/
def F19_P (n : Nat) : Prop :=
  ∃ a b c a' b' c' : Nat, 0 < a ∧ a < b ∧ b < c ∧ 0 < a' ∧ a' < b' ∧ b' < c' ∧
    a + b + c = n ∧ a' + b' + c' = n ∧ (a, b, c) ≠ (a', b', c') ∧ a * b * c = a' * b' * c'

theorem F19_prod_eq (x y z : Nat) : (2 * x) * (2 * y) * (3 * z) = (3 * x) * y * (4 * z) := by
  have h1 : (2 * x) * (2 * y) * (3 * z) = (2 * 2 * 3) * (x * y * z) := by ac_rfl
  have h2 : (3 * x) * y * (4 * z) = (3 * 4) * (x * y * z) := by ac_rfl
  rw [h1, h2]

theorem F19_family (t s w : Nat) (ht : 37 ≤ t) (hs : s ≤ 18) (hw : w ≤ 18) : F19_P (19 * t + 4 * s + 5 * w) := by
  refine ⟨2 * t + 2 * s, 8 * t + 2 * s + 2 * w, 9 * t + 3 * w,
          3 * t + 3 * s, 4 * t + s + w, 12 * t + 4 * w, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  all_goals try omega
  · intro h; simp only [Prod.mk.injEq] at h; omega
  · have e1 : 2 * t + 2 * s = 2 * (t + s) := by omega
    have e2 : 8 * t + 2 * s + 2 * w = 2 * (4 * t + s + w) := by omega
    have e3 : 9 * t + 3 * w = 3 * (3 * t + w) := by omega
    have e4 : 3 * t + 3 * s = 3 * (t + s) := by omega
    have e5 : 12 * t + 4 * w = 4 * (3 * t + w) := by omega
    rw [e1, e2, e3, e4, e5]; exact F19_prod_eq _ _ _

/-- residue table: (4s + 5w) % 19 = r with s, w ≤ 18 -/
def F19_sw : List (Nat × Nat) :=
  (List.range 19).map (fun r =>
    ((List.range 19).flatMap (fun s => (List.range 19).map (fun w => (s, w)))).foldl
      (fun acc p => if (4 * p.1 + 5 * p.2) % 19 == r && 4 * p.1 + 5 * p.2 < 4 * acc.1 + 5 * acc.2 then p else acc)
      (18, 18))

theorem F19_sw_ok : ∀ r ∈ List.range 19,
    (F19_sw.getD r (0, 0)).1 ≤ 18 ∧ (F19_sw.getD r (0, 0)).2 ≤ 18 ∧
    (4 * (F19_sw.getD r (0, 0)).1 + 5 * (F19_sw.getD r (0, 0)).2) % 19 = r := by decide +kernel

theorem F19_large (n : Nat) (hn : 865 ≤ n) : F19_P n := by
  have hr : n % 19 ∈ List.range 19 := List.mem_range.mpr (Nat.mod_lt _ (by decide))
  obtain ⟨hs, hw, hm⟩ := F19_sw_ok _ hr
  generalize (F19_sw.getD (n % 19) (0, 0)).1 = s at hs hm
  generalize (F19_sw.getD (n % 19) (0, 0)).2 = w at hw hm
  have ht : 37 ≤ (n - 4 * s - 5 * w) / 19 := by omega
  have he : n = 19 * ((n - 4 * s - 5 * w) / 19) + 4 * s + 5 * w := by omega
  rw [he]; exact F19_family _ s w ht hs hw

