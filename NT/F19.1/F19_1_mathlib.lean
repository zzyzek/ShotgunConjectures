def F19_good (e : Nat × Nat × Nat × Nat × Nat) : Bool :=
  let (n, a, b, a', b') := e
  decide (0 < a ∧ a < b ∧ b < n - a - b ∧ a + b < n ∧ 0 < a' ∧ a' < b' ∧ b' < n - a' - b' ∧
    a' + b' < n ∧ (a ≠ a' ∨ b ≠ b') ∧ a * b * (n - a - b) = a' * b' * (n - a' - b'))

theorem F19_tab_good : F19_tab.all F19_good = true := by decide +kernel
theorem F19_tab_keys : F19_tab.map (·.1) = List.range' 23 842 := by decide +kernel

theorem F19_small (n : Nat) (h1 : 23 ≤ n) (h2 : n ≤ 864) : F19_P n := by
  have hm : n ∈ F19_tab.map (·.1) := by
    rw [F19_tab_keys]; exact List.mem_range'.mpr ⟨n - 23, by omega, by omega⟩
  obtain ⟨⟨n', a, b, a', b'⟩, he, hk⟩ := List.mem_map.mp hm
  have hg := List.all_eq_true.mp F19_tab_good _ he
  simp only [F19_good, decide_eq_true_eq] at hg
  simp only at hk
  subst hk
  obtain ⟨h0, hab, hbc, hs, h0', hab', hbc', hs', hne, hp⟩ := hg
  refine ⟨a, b, n' - a - b, a', b', n' - a' - b', h0, hab, hbc, h0', hab', hbc', by omega, by omega, ?_, hp⟩
  intro h; simp only [Prod.mk.injEq] at h; omega

theorem F19_recaman (n : Nat) (h : 23 ≤ n) : F19_P n := by
  by_cases hn : 865 ≤ n
  · exact F19_large n hn
  · exact F19_small n h (by omega)

/-! ### Equal parts allowed, and the finite range n ≤ 22 -/

/-- Two different weakly increasing positive triples with sum n and equal product. -/
def F19_Q (n : Nat) : Prop :=
  ∃ a b c a' b' c' : Nat, 0 < a ∧ a ≤ b ∧ b ≤ c ∧ 0 < a' ∧ a' ≤ b' ∧ b' ≤ c' ∧
    a + b + c = n ∧ a' + b' + c' = n ∧ (a, b, c) ≠ (a', b', c') ∧ a * b * c = a' * b' * c'

theorem F19_Q_of_P (n : ℕ) (h : F19_P n) : F19_Q n := by
  obtain ⟨a, b, c, a', b', c', h1, h2, h3, h4, h5, h6, h7, h8, h9, h10⟩ := h
  exact ⟨a, b, c, a', b', c', h1, h2.le, h3.le, h4, h5.le, h6.le, h7, h8, h9, h10⟩

/-- All triples (a, b, n - a - b) with `cond`. -/
def F19_parts (cond : ℕ → ℕ → ℕ → Bool) (n : ℕ) : List (ℕ × ℕ × ℕ) :=
  (List.range n).flatMap (fun a => (List.range n).filterMap
    (fun b => if a + b < n ∧ cond a b (n - a - b) = true then some (a, b, n - a - b) else none))

def F19_pairCheck (cond : ℕ → ℕ → ℕ → Bool) (n : ℕ) : Bool :=
  (F19_parts cond n).any (fun x => (F19_parts cond n).any
    (fun y => x != y && x.1 * x.2.1 * x.2.2 == y.1 * y.2.1 * y.2.2))

theorem F19_mem_parts (cond : ℕ → ℕ → ℕ → Bool) (n : ℕ) (x : ℕ × ℕ × ℕ) :
    x ∈ F19_parts cond n ↔ ∃ a b, a + b < n ∧ cond a b (n - a - b) = true ∧
      x = (a, b, n - a - b) := by
  simp only [F19_parts, List.mem_flatMap, List.mem_range, List.mem_filterMap,
    Option.ite_none_right_eq_some, Option.some.injEq]
  constructor
  · rintro ⟨a, _, b, _, ⟨h1, h2⟩, rfl⟩
    exact ⟨a, b, h1, h2, rfl⟩
  · rintro ⟨a, b, h1, h2, rfl⟩
    exact ⟨a, by omega, b, by omega, ⟨h1, h2⟩, rfl⟩

theorem F19_pairCheck_iff (cond : ℕ → ℕ → ℕ → Bool) (hcond : ∀ a b, cond a b 0 = false)
    (n : ℕ) :
    F19_pairCheck cond n = true ↔
      ∃ a b c a' b' c' : Nat, cond a b c = true ∧ cond a' b' c' = true ∧
        a + b + c = n ∧ a' + b' + c' = n ∧ (a, b, c) ≠ (a', b', c') ∧
        a * b * c = a' * b' * c' := by
  simp only [F19_pairCheck, List.any_eq_true, Bool.and_eq_true, bne_iff_ne, ne_eq,
    beq_iff_eq, F19_mem_parts]
  constructor
  · rintro ⟨x, ⟨a, b, h1, h2, rfl⟩, y, ⟨a', b', h1', h2', rfl⟩, hne, hp⟩
    exact ⟨a, b, n - a - b, a', b', n - a' - b', h2, h2', by omega, by omega, hne, hp⟩
  · rintro ⟨a, b, c, a', b', c', h1, h2, h3, h4, hne, hp⟩
    have hc : c = n - a - b := by omega
    have hc' : c' = n - a' - b' := by omega
    subst hc hc'
    refine ⟨(a, b, n - a - b), ⟨a, b, ?_, h1, rfl⟩, (a', b', n - a' - b'),
      ⟨a', b', ?_, h2, rfl⟩, hne, hp⟩
    · by_contra hh
      have : n - a - b = 0 := by omega
      rw [this, hcond] at h1
      exact absurd h1 (by decide)
    · by_contra hh
      have : n - a' - b' = 0 := by omega
      rw [this, hcond] at h2
      exact absurd h2 (by decide)

def F19_condP (a b c : ℕ) : Bool := decide (0 < a ∧ a < b ∧ b < c)

def F19_condQ (a b c : ℕ) : Bool := decide (0 < a ∧ a ≤ b ∧ b ≤ c ∧ 0 < c)

theorem F19_P_iff (n : ℕ) : F19_P n ↔ F19_pairCheck F19_condP n = true := by
  rw [F19_pairCheck_iff F19_condP (fun a b => by simp [F19_condP])]
  simp only [F19_condP, decide_eq_true_eq, F19_P]
  constructor
  · rintro ⟨a, b, c, a', b', c', h1, h2, h3, h4, h5, h6, h7, h8, h9, h10⟩
    exact ⟨a, b, c, a', b', c', ⟨h1, h2, h3⟩, ⟨h4, h5, h6⟩, h7, h8, h9, h10⟩
  · rintro ⟨a, b, c, a', b', c', ⟨h1, h2, h3⟩, ⟨h4, h5, h6⟩, h7, h8, h9, h10⟩
    exact ⟨a, b, c, a', b', c', h1, h2, h3, h4, h5, h6, h7, h8, h9, h10⟩

theorem F19_Q_iff (n : ℕ) : F19_Q n ↔ F19_pairCheck F19_condQ n = true := by
  rw [F19_pairCheck_iff F19_condQ (fun a b => by simp [F19_condQ])]
  simp only [F19_condQ, decide_eq_true_eq, F19_Q]
  constructor
  · rintro ⟨a, b, c, a', b', c', h1, h2, h3, h4, h5, h6, h7, h8, h9, h10⟩
    exact ⟨a, b, c, a', b', c', ⟨h1, h2, h3, by omega⟩, ⟨h4, h5, h6, by omega⟩, h7, h8, h9, h10⟩
  · rintro ⟨a, b, c, a', b', c', ⟨h1, h2, h3, _⟩, ⟨h4, h5, h6, _⟩, h7, h8, h9, h10⟩
    exact ⟨a, b, c, a', b', c', h1, h2, h3, h4, h5, h6, h7, h8, h9, h10⟩

theorem F19_small_P : ∀ n, n ≤ 22 → (F19_pairCheck F19_condP n = true ↔ 19 ≤ n ∧ n ≠ 22) := by
  decide +kernel

theorem F19_small_Q : ∀ n, n ≤ 22 →
    (F19_pairCheck F19_condQ n = true ↔ ¬ (n ≤ 12 ∨ n = 15 ∨ n = 18)) := by
  decide +kernel

theorem F19_1_main : ∀ n : ℕ, (F19_P n ↔ 19 ≤ n ∧ n ≠ 22) ∧
    (F19_Q n ↔ ¬ (n ≤ 12 ∨ n = 15 ∨ n = 18)) := by
  intro n
  by_cases hn : 23 ≤ n
  · have hP := F19_recaman n hn
    exact ⟨⟨fun _ => ⟨by omega, by omega⟩, fun _ => hP⟩,
      ⟨fun _ => by omega, fun _ => F19_Q_of_P n hP⟩⟩
  · rw [F19_P_iff, F19_Q_iff]
    exact ⟨F19_small_P n (by omega), F19_small_Q n (by omega)⟩
