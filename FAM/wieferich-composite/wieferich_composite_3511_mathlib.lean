/-- The 146-digit prime factor of Phi_1755(2) (primality not checked in Lean). -/
def bigP146 : ℕ :=
  25006596829256741460214169653933852849128490077459890197421900490545433220443136638425782879171530372521984642165350019685875922245867185516694881

/-- 2^3510 - 1 is the product of the listed prime powers. -/
theorem factorsProd_3510 : factorsProd fs3510 = 2 ^ 3510 - 1 := by decide +kernel

theorem nodup_3510 : (fs3510.map Prod.fst).Nodup := by decide +kernel

/-- Every listed factor other than `bigP146` is prime (Pratt certificates). -/
theorem primes_3510_small : ∀ n ∈ (fs3510.map Prod.fst).filter (· ≠ bigP146), n.Prime :=
  primes_of_prattCertifiesAll _ cert3510 (by decide +kernel)

theorem primes_3510 (h146 : bigP146.Prime) :
    ∀ qk ∈ fs3510, qk.1.Prime := by
  intro qk hqk
  by_cases h : qk.1 = bigP146
  · rw [h]; exact h146
  · exact primes_3510_small _ (List.mem_filter.mpr ⟨List.mem_map_of_mem hqk, by simpa using h⟩)

/-- If `bigP146` is prime, the primes whose square divides 2^3510 - 1 are
3 and 3511. -/
theorem sq_dvd_two_pow_3510 (h146 : bigP146.Prime)
    (P : ℕ) (hP : P.Prime) (h : P ^ 2 ∣ 2 ^ 3510 - 1) : P = 3 ∨ P = 3511 := by
  rw [← factorsProd_3510] at h
  obtain ⟨qk, hmem, he, hk⟩ :=
    sq_dvd_factorsProd fs3510 (primes_3510 h146) nodup_3510 P hP h
  have hall : ∀ qk ∈ fs3510, 2 ≤ qk.2 → qk.1 = 3 ∨ qk.1 = 3511 := by
    decide +kernel
  rw [← he]
  exact hall qk hmem hk

theorem not_modEq_3511_4 : ¬ 2 ^ 3510 ≡ 1 [MOD 3511 ^ 4] := by
  unfold Nat.ModEq; rw [← powMod_eq]; decide +kernel

/-- 3511^2 divides no solution. -/
theorem wief_not_3511_sq (c : ℕ) (hc : 0 < c) (hd : 3511 ^ 2 ∣ c)
    (h : 2 ^ (c - 1) ≡ 1 [MOD c ^ 2]) : False := by
  have hw := wief_sq_factor c 3511 hc (by norm_num) hd h
  rw [show (3511 : ℕ) - 1 = 3510 by norm_num] at hw
  exact not_modEq_3511_4 hw

/-- If `bigP146` is prime: no c = 3511^b * P^k (b, k ≥ 1, P ≠ 3511 prime) is
a solution. b ≥ 2 is excluded by `wief_not_3511_sq`; for b = 1 the cofactor lemma gives
P^2 ∣ 2^3510 - 1, so P = 3, and 3 is not a Wieferich prime. -/
theorem wief_no_3511_prime_power (h146 : bigP146.Prime)
    (b k P : ℕ) (hP : P.Prime) (hP3511 : P ≠ 3511) (hb : 1 ≤ b) (hk : 1 ≤ k) :
    ¬ 2 ^ (3511 ^ b * P ^ k - 1) ≡ 1 [MOD (3511 ^ b * P ^ k) ^ 2] := by
  intro h
  have hc : 0 < 3511 ^ b * P ^ k := by have := hP.pos; positivity
  rcases Nat.lt_or_ge b 2 with hb2 | hb2
  · have hb1 : b = 1 := by omega
    subst hb1
    have hw := wief_cofactor _ P k 3511 hP hk (by norm_num) (by ring) h
    rw [show (3511 : ℕ) - 1 = 3510 by norm_num] at hw
    have hsq : P ^ 2 ∣ P ^ (2 * k) := pow_dvd_pow P (by omega)
    have key : ∀ E : ℕ, 0 < E → E ≡ 1 [MOD P ^ (2 * k)] → P ^ (2 * k) ∣ E - 1 :=
      fun E hE he => (Nat.modEq_iff_dvd' hE).mp he.symm
    have h1 : P ^ 2 ∣ 2 ^ 3510 - 1 := hsq.trans (key (2 ^ 3510) (by positivity) hw.2)
    have h2 : 2 ^ (P - 1) ≡ 1 [MOD P ^ 2] := Nat.ModEq.of_dvd hsq hw.1
    rcases sq_dvd_two_pow_3510 h146 P hP h1 with rfl | rfl
    · exact absurd h2 (by decide)
    · exact hP3511 rfl
  · apply wief_not_3511_sq _ hc _ h
    exact Dvd.dvd.mul_right (pow_dvd_pow 3511 hb2) _
