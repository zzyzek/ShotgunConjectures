theorem casas_alvero_root_deg_6 [CharZero K] (P : K[X]) (hP : P.Monic)
    (hd : P.natDegree = 6) (h : HasCasasAlveroPropR P) : ∃ a, P = (X - C a) ^ 6 := by
  have hh : ∀ i < 6, ∃ α, P.eval α = 0 ∧ (P.hasseDeriv i).eval α = 0 := fun i hi => by
    obtain ⟨α, h1, h2⟩ := h i (by simp [hd, hi])
    exact ⟨α, h1, h2⟩
  have cd : P.coeff 6 = 1 := by rw [← hd]; exact hP.coeff_natDegree
  obtain ⟨x1, p1, q1⟩ := hh 1 (by norm_num)
  obtain ⟨x2, p2, q2⟩ := hh 2 (by norm_num)
  obtain ⟨x3, p3, q3⟩ := hh 3 (by norm_num)
  obtain ⟨x4, p4, q4⟩ := hh 4 (by norm_num)
  obtain ⟨x5, p5, q5⟩ := hh 5 (by norm_num)
  rw [eval_eq_sum_range' (n := 7) (by omega)] at p1 p2 p3 p4 p5
  rw [eval_hasseDeriv_sum P hd] at q1 q2 q3 q4 q5
  simp only [Finset.sum_range_succ, Finset.sum_range_zero] at p1 p2 p3 p4 p5 q1 q2 q3 q4 q5
  norm_num [Nat.choose, cd] at p1 p2 p3 p4 p5 q1 q2 q3 q4 q5
  set c0 := P.coeff 0 with hc0
  set c1 := P.coeff 1 with hc1
  set c2 := P.coeff 2 with hc2
  set c3 := P.coeff 3 with hc3
  set c4 := P.coeff 4 with hc4
  set c5 := P.coeff 5 with hc5
  obtain ⟨z1, z2, z3, z4⟩ := core6 (c1 + 2*c2*x5 + 3*c3*x5^2 + 4*c4*x5^3 + 5*c5*x5^4 + 6*x5^5) (c2 + 3*c3*x5 + 6*c4*x5^2 + 10*c5*x5^3 + 15*x5^4) (c3 + 4*c4*x5 + 10*c5*x5^2 + 20*x5^3) (c4 + 5*c5*x5 + 15*x5^2) (x1 - x5) (x2 - x5) (x3 - x5) (x4 - x5)
    (by linear_combination p1 - p5 - (x1 - x5)^5 * q5)
    (by linear_combination q1 - 5 * (x1 - x5)^4 * q5)
    (by linear_combination p2 - p5 - (x2 - x5)^5 * q5)
    (by linear_combination q2 - 10 * (x2 - x5)^3 * q5)
    (by linear_combination p3 - p5 - (x3 - x5)^5 * q5)
    (by linear_combination q3 - 10 * (x3 - x5)^2 * q5)
    (by linear_combination p4 - p5 - (x4 - x5)^5 * q5)
    (by linear_combination q4 - 5 * (x4 - x5)^1 * q5)
  refine ⟨x5, eq_X_sub_C_pow P hP hd x5 ?_⟩
  intro j hj
  interval_cases j
  · norm_num [Nat.choose]
    linear_combination (1) * p5 + (-x5) * z1 + (x5^2) * z2 + (-x5^3) * z3 + (x5^4) * z4 + (-x5^5) * q5
  · norm_num [Nat.choose]
    linear_combination (1) * z1 + (-2*x5) * z2 + (3*x5^2) * z3 + (-4*x5^3) * z4 + (5*x5^4) * q5
  · norm_num [Nat.choose]
    linear_combination (1) * z2 + (-3*x5) * z3 + (6*x5^2) * z4 + (-10*x5^3) * q5
  · norm_num [Nat.choose]
    linear_combination (1) * z3 + (-4*x5) * z4 + (10*x5^2) * q5
  · norm_num [Nat.choose]
    linear_combination (1) * z4 + (-5*x5) * q5
  · norm_num [Nat.choose]
    linear_combination (1) * q5

/-- Casas-Alvero in degree 6, in the formal-conjectures statement shape. -/
theorem casas_alvero_deg_6 [CharZero K] (P : K[X]) (hP : P.Monic) (hd : P.natDegree = 6)
    (hca : HasCasasAlveroProp P) : ∃ α : K, P = (X - C α) ^ P.natDegree :=
  of_algClosure P hP hd hca fun Q hQ hQd hQr => casas_alvero_root_deg_6 Q hQ hQd hQr

