/-- Rows 0..29: row n of rows^n has g.f. (n^2 + y)^n. -/
theorem eq_upto29 : ∀ n, n < 30 → rowPow rows n n = target n
  | 0, _ => eq_0
  | 1, _ => eq_1
  | 2, _ => eq_2
  | 3, _ => eq_3
  | 4, _ => eq_4
  | 5, _ => eq_5
  | 6, _ => eq_6
  | 7, _ => eq_7
  | 8, _ => eq_8
  | 9, _ => eq_9
  | 10, _ => eq_10
  | 11, _ => eq_11
  | 12, _ => eq_12
  | 13, _ => eq_13
  | 14, _ => eq_14
  | 15, _ => eq_15
  | 16, _ => eq_16
  | 17, _ => eq_17
  | 18, _ => eq_18
  | 19, _ => eq_19
  | 20, _ => eq_20
  | 21, _ => eq_21
  | 22, _ => eq_22
  | 23, _ => eq_23
  | 24, _ => eq_24
  | 25, _ => eq_25
  | 26, _ => eq_26
  | 27, _ => eq_27
  | 28, _ => eq_28
  | 29, _ => eq_29
  | n + 30, h => absurd h (by omega)

/-- T with row 30 = R/2. Scaled iteration w = 2 v: since w 30 = 2 throughout (unitriangular),
    2 (v * T) = sum_{i<30} w_i rows_i + R. -/
def step30 (w : List Int) : List Int := addScaled (vecMul [] (w.take 30) rows) ((get w 30) / 2) R

def row30Scaled : List Int := iter step30 30 (List.replicate 30 0 ++ [2])

theorem R_last : get R 30 = 2 ∧ R.length = 31 := by decide +kernel

theorem eq_row30 : row30Scaled = (target 30).map (2 * ·) := by decide +kernel

theorem R0_odd : get R 0 % 2 = 1 := by decide +kernel

/-- Main (k = 1 of Hanna's conjecture, the triangle of A132870): the integer rows 0..29 and the
    row R/2 satisfy the defining equations for n <= 30, and 2 does not divide R 0, so the entry
    T(30,0) = R 0 / 2 of the (unique, see header) solution is not an integer. -/
theorem A132870_row30_not_integral :
    (∀ n, n < 30 → rowPow rows n n = target n) ∧
    row30Scaled = (target 30).map (2 * ·) ∧ get R 30 = 2 ∧ get R 0 % 2 = 1 :=
  ⟨eq_upto29, eq_row30, R_last.1, R0_odd⟩
