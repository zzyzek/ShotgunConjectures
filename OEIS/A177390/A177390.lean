/-- acc + a * r, padding the shorter list with zeros. -/
def addScaled : List Int → Int → List Int → List Int
  | acc, _, [] => acc
  | x :: xs, a, y :: ys => (x + a * y) :: addScaled xs a ys
  | [], a, y :: ys => (a * y) :: addScaled [] a ys

/-- acc + sum_i v_i * M_i. -/
def vecMul : List Int → List Int → List (List Int) → List Int
  | acc, [], _ => acc
  | acc, _, [] => acc
  | acc, a :: v, r :: M => vecMul (addScaled acc a r) v M

def iter (f : List Int → List Int) : Nat → List Int → List Int
  | 0, v => v
  | k + 1, v => iter f k (f v)

/-- unit row vector e_n of length n + 1. -/
def unit (n : Nat) : List Int := (List.replicate n 0) ++ [1]

/-- row n of M^e, M given by its first n + 1 rows. -/
def rowPow (M : List (List Int)) (n e : Nat) : List Int :=
  iter (fun v => vecMul [] v (M.take (n + 1))) e (unit n)

/-- coefficients (constant term first) of (a + y)^n. -/
def binomPow (a : Int) : Nat → List Int
  | 0 => [1]
  | n + 1 => addScaled ((binomPow a n).map (a * ·)) 1 (0 :: binomPow a n)

def target (n : Nat) : List Int := binomPow ((n * n : Nat) : Int) n

def get (v : List Int) (i : Nat) : Int := v.getD i 0

def unitri : Bool :=
  (List.range 30).all fun i => (rows.getD i []).length == i + 1 && get (rows.getD i []) i == 1

theorem rows_unitri : unitri = true := by decide +kernel

/-- Pascal check of `target`: (1 + y)^3 = 1 + 3y + 3y^2 + y^3 (sanity). -/
theorem target_sanity : binomPow 1 3 = [1, 3, 3, 1] ∧ target 2 = [16, 8, 1] := by decide +kernel

