/-
OEIS A104895, conjecture: the positions where 0, 1, 2, 3, ... appear are
given by A048724 (k XOR 2k); the positions where -1, -2, -3, ... appear
are given by A065621.

Definition used.  `a` is the recursion that generates the entry's data and
b-file and is used by all its programs (Maple, Mathematica, Sage):
a(0) = 0, a(2n) = 2a(n), a(2n+1) = -2a(n) - 1 (`a_even`, `a_odd`).  The
%N name line as printed, a(2n) = -2a(n), a(2n+1) = 2a(n) - 1, gives a(2) = 2
against the data value -2 (`printedName_differs`).  `a` is written with an
explicit fuel argument so that `decide` can evaluate it; `data_check`
compares a(0..77) with the %S/%T/%U data of the entry.

A048724(k) = k XOR 2k (its name line).  A065621(k) = (k-1) XOR (2k-1), a
formula in the A065621 entry; `A048724_data` and `A065621_data` compare
both with the first data terms of those entries.

Main theorems.
* `A104895_positions_nonneg`: for all k n : ℕ, a(n) = k ↔ n = A048724(k).
* `A104895_positions_neg`: for all k ≥ 1 and n, a(n) = -k ↔ n = A065621(k).
* `A104895_bijective`: a : ℕ → ℤ is a bijection (every integer occurs
  exactly once).

Proof.  With P = A048724 and Q = A065621, P(2m) = 2P(m),
P(2m+1) = 2Q(m+1)+1, Q(2m+1) = 2P(m)+1, Q(2m+2) = 2Q(m+1) (bitwise XOR of
2x+b and 2y+c).  Strong induction on k gives a(P k) = k and
a(Q(k+1)) = -(k+1).  a is injective because a(2m) is even, a(2m+1) is odd,
and a(n) = 0 only at n = 0.

Not checked: nothing outside Lean (the b-file comparison for n ≤ 20000 is
in certificate/check.py and is not needed for the theorems).
-/
import Mathlib

/-- Data recursion with fuel `f`: a(0) = 0, a(2n) = 2a(n), a(2n+1) = -2a(n) - 1. -/
def aF : ℕ → ℕ → ℤ
  | 0, _ => 0
  | f + 1, n =>
    if n = 0 then 0
    else if n % 2 = 0 then 2 * aF f (n / 2) else -2 * aF f (n / 2) - 1

/-- A104895 as generated by its data. -/
def a (n : ℕ) : ℤ := aF n n

/-- The %N recursion as printed: a(2n) = -2a(n), a(2n+1) = 2a(n) - 1. -/
def bF : ℕ → ℕ → ℤ
  | 0, _ => 0
  | f + 1, n =>
    if n = 0 then 0
    else if n % 2 = 0 then -2 * bF f (n / 2) else 2 * bF f (n / 2) - 1

/-- A048724(k) = k XOR 2k. -/
def A048724 (k : ℕ) : ℕ := k ^^^ (2 * k)

/-- A065621(k) = (k-1) XOR (2k-1), for k ≥ 1. -/
def A065621 (k : ℕ) : ℕ := (k - 1) ^^^ (2 * k - 1)

theorem data_check :
    (List.range 78).map a =
      [0, -1, -2, 1, -4, 3, 2, -3, -8, 7, 6, -7, 4, -5, -6, 5, -16, 15, 14, -15, 12, -13,
       -14, 13, 8, -9, -10, 9, -12, 11, 10, -11, -32, 31, 30, -31, 28, -29, -30, 29, 24, -25,
       -26, 25, -28, 27, 26, -27, 16, -17, -18, 17, -20, 19, 18, -19, -24, 23, 22, -23, 20,
       -21, -22, 21, -64, 63, 62, -63, 60, -61, -62, 61, 56, -57, -58, 57, -60, 59] := by
  decide +kernel

theorem printedName_differs : bF 2 2 = 2 ∧ a 2 = -2 := by decide +kernel

theorem A048724_data :
    (List.range 20).map A048724 =
      [0, 3, 6, 5, 12, 15, 10, 9, 24, 27, 30, 29, 20, 23, 18, 17, 48, 51, 54, 53] := by
  decide +kernel

theorem A065621_data :
    (List.range' 1 20).map A065621 =
      [1, 2, 7, 4, 13, 14, 11, 8, 25, 26, 31, 28, 21, 22, 19, 16, 49, 50, 55, 52] := by
  decide +kernel

lemma aF_eq (f g n : ℕ) (hf : n ≤ f) (hg : n ≤ g) : aF f n = aF g n := by
  induction f generalizing g n with
  | zero =>
    obtain rfl : n = 0 := by omega
    cases g <;> simp [aF]
  | succ f ih =>
    cases g with
    | zero =>
      obtain rfl : n = 0 := by omega
      simp [aF]
    | succ g =>
      simp only [aF]
      rw [ih g (n / 2) (by omega) (by omega)]

lemma a_unfold (n : ℕ) (hn : n ≠ 0) :
    a n = if n % 2 = 0 then 2 * a (n / 2) else -2 * a (n / 2) - 1 := by
  obtain ⟨f, rfl⟩ : ∃ f, n = f + 1 := ⟨n - 1, by omega⟩
  simp only [a, aF, Nat.add_one_ne_zero, ↓reduceIte]
  rw [aF_eq f ((f + 1) / 2) ((f + 1) / 2) (by omega) le_rfl]

lemma a_zero : a 0 = 0 := rfl

lemma a_even (m : ℕ) : a (2 * m) = 2 * a m := by
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · simp [a_zero]
  · rw [a_unfold _ (by omega)]
    simp only [show 2 * m % 2 = 0 by omega, show 2 * m / 2 = m by omega, ↓reduceIte]

lemma a_odd (m : ℕ) : a (2 * m + 1) = -2 * a m - 1 := by
  rw [a_unfold _ (by omega)]
  simp only [show (2 * m + 1) % 2 = 1 by omega, show (2 * m + 1) / 2 = m by omega,
    one_ne_zero, ↓reduceIte]

lemma xor_bits (m n : ℕ) (b c : Bool) :
    (2 * m + b.toNat) ^^^ (2 * n + c.toNat) = 2 * (m ^^^ n) + (bne b c).toNat := by
  have h := Nat.xor_bit b m c n
  simpa only [Nat.bit_val] using h

lemma xor_ee (m n : ℕ) : (2 * m) ^^^ (2 * n) = 2 * (m ^^^ n) := by
  simpa using xor_bits m n false false

lemma xor_oe (m n : ℕ) : (2 * m + 1) ^^^ (2 * n) = 2 * (m ^^^ n) + 1 := by
  simpa using xor_bits m n true false

lemma xor_eo (m n : ℕ) : (2 * m) ^^^ (2 * n + 1) = 2 * (m ^^^ n) + 1 := by
  simpa using xor_bits m n false true

lemma xor_oo (m n : ℕ) : (2 * m + 1) ^^^ (2 * n + 1) = 2 * (m ^^^ n) := by
  simpa using xor_bits m n true true

lemma P_even (m : ℕ) : A048724 (2 * m) = 2 * A048724 m := by
  simp only [A048724]
  rw [xor_ee]

lemma P_odd (m : ℕ) : A048724 (2 * m + 1) = 2 * A065621 (m + 1) + 1 := by
  simp only [A048724, A065621]
  rw [xor_oe, show m + 1 - 1 = m by omega, show 2 * (m + 1) - 1 = 2 * m + 1 by omega]

lemma Q_odd (m : ℕ) : A065621 (2 * m + 1) = 2 * A048724 m + 1 := by
  simp only [A048724, A065621]
  rw [show 2 * m + 1 - 1 = 2 * m by omega,
    show 2 * (2 * m + 1) - 1 = 2 * (2 * m) + 1 by omega, xor_eo]

lemma Q_even (m : ℕ) : A065621 (2 * m + 2) = 2 * A065621 (m + 1) := by
  simp only [A065621]
  rw [show 2 * m + 2 - 1 = 2 * m + 1 by omega,
    show 2 * (2 * m + 2) - 1 = 2 * (2 * m + 1) + 1 by omega, xor_oo,
    show m + 1 - 1 = m by omega, show 2 * (m + 1) - 1 = 2 * m + 1 by omega]

theorem a_P_Q (k : ℕ) : a (A048724 k) = k ∧ a (A065621 (k + 1)) = -((k : ℤ) + 1) := by
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    obtain ⟨m, rfl | rfl⟩ := Nat.even_or_odd' k
    · have hP : a (A048724 m) = m := by
        rcases Nat.eq_zero_or_pos m with rfl | hm
        · rfl
        · exact (ih m (by omega)).1
      refine ⟨?_, ?_⟩
      · rw [P_even, a_even, hP]; push_cast; ring
      · rw [Q_odd, a_odd, hP]; push_cast; ring
    · have hQ := (ih m (by omega)).2
      refine ⟨?_, ?_⟩
      · rw [P_odd, a_odd, hQ]; push_cast; ring
      · rw [show 2 * m + 1 + 1 = 2 * m + 2 by ring, Q_even, a_even, hQ]; push_cast; ring

lemma a_eq_zero (n : ℕ) (h : a n = 0) : n = 0 := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    obtain ⟨m, rfl | rfl⟩ := Nat.even_or_odd' n
    · rw [a_even] at h
      rcases Nat.eq_zero_or_pos m with rfl | hm
      · rfl
      · have := ih m (by omega) (by omega)
        omega
    · rw [a_odd] at h
      omega

theorem a_injective : Function.Injective a := by
  intro x
  induction x using Nat.strong_induction_on with
  | _ x ih =>
    intro y h
    obtain ⟨m, rfl | rfl⟩ := Nat.even_or_odd' x <;>
      obtain ⟨n, rfl | rfl⟩ := Nat.even_or_odd' y
    · rw [a_even, a_even] at h
      rcases Nat.eq_zero_or_pos m with rfl | hm
      · have := a_eq_zero n (by rw [a_zero] at h; omega)
        omega
      · have := ih m (by omega) (by omega : a m = a n)
        omega
    · rw [a_even, a_odd] at h; omega
    · rw [a_odd, a_even] at h; omega
    · rw [a_odd, a_odd] at h
      have := ih m (by omega) (by omega : a m = a n)
      omega

theorem A104895_positions_nonneg (k n : ℕ) : a n = (k : ℤ) ↔ n = A048724 k :=
  ⟨fun h => a_injective (h.trans (a_P_Q k).1.symm), fun h => h ▸ (a_P_Q k).1⟩

theorem A104895_positions_neg (k n : ℕ) (hk : 1 ≤ k) : a n = -(k : ℤ) ↔ n = A065621 k := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
  have hj := (a_P_Q j).2
  push_cast
  exact ⟨fun h => a_injective (h.trans hj.symm), fun h => h ▸ hj⟩

theorem A104895_bijective : Function.Bijective a := by
  refine ⟨a_injective, fun z => ?_⟩
  obtain ⟨k, rfl | rfl⟩ := Int.eq_nat_or_neg z
  · exact ⟨_, (a_P_Q k).1⟩
  · rcases Nat.eq_zero_or_pos k with rfl | hk
    · exact ⟨0, rfl⟩
    · exact ⟨_, (A104895_positions_neg k _ hk).2 rfl⟩
