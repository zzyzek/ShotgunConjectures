def Composite (x : Nat) : Prop := ∃ d, 1 < d ∧ d < x ∧ d ∣ x

theorem window (m : Nat) (h1 : 1 ≤ m) (h2 : m < 17159) :
    Composite (L + m) ∨ Composite (L + m + 2) := by
  have hm : m = 625 * (m / 625) + 25 * (m % 625 / 25) + m % 25 := by omega
  have h := good_all (m / 625) (by omega) (m % 625 / 25) (by omega) (m % 25) (by omega)
  rw [← hm] at h
  rcases h with h | h | h
  · omega
  · omega
  · unfold good at h
    simp only [Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq, decide_eq_true_eq] at h
    obtain ⟨⟨⟨hs, hd1⟩, hd2⟩, hdv⟩ := h
    rcases hs with hs | hs
    · left
      rw [hs, Nat.add_zero] at hd2 hdv
      exact ⟨(wit m).2, hd1, hd2, Nat.dvd_of_mod_eq_zero hdv⟩
    · right
      rw [hs] at hd2 hdv
      exact ⟨(wit m).2, hd1, hd2, Nat.dvd_of_mod_eq_zero hdv⟩

