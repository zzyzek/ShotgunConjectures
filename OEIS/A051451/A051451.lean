def wit (m : Nat) : Nat × Nat :=
  match smallq.find? (fun q => m % q == 0) with
  | some q => (0, q)
  | none =>
    match smallq.find? (fun q => (m + 2) % q == 0) with
    | some q => (2, q)
    | none =>
      match hard.find? (fun t => t.1 == m) with
      | some t => (t.2.1, t.2.2)
      | none => (0, 1)

def good (m : Nat) : Bool :=
  let w := wit m
  (w.1 == 0 || w.1 == 2) && decide (1 < w.2) && decide (w.2 < L + m + w.1) &&
    (L + m + w.1) % w.2 == 0

