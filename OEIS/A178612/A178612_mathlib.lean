/-
OEIS A178612 (Mathlib): positive values of F(p,q) = p^6 - 4p^4 q + 4p^2 q^2 + 4q^3 with pq ≠ 0.
Conjecture in the entry: no term is a perfect square.

Checked here:
* `A178612_toE`: if F(p,q) = y^2 with p ≠ 0 then (x, y') = (4q/p^2, 4y/p^3) is a rational point of
  E : y^2 = x^3 + 4x^2 - 16x + 16.
* `A178612_no_square`: main theorem, conditional on the hypothesis `hE` that every affine rational point of E
  has x = 0.
Not checked here (outside Lean): `hE` itself. E has conductor 35, rank 0 (PARI/GP ellrank 2-descent bounds
[0, 0]; L(E,1) ≠ 0) and torsion Z/3 generated by (0, 4), so E(Q) = {O, (0, 4), (0, -4)}.
-/
import Mathlib

/-- F(p,q) = p^6 - 4p^4 q + 4p^2 q^2 + 4q^3. -/
def A178612_F (p q : ℤ) : ℤ := p ^ 6 - 4 * p ^ 4 * q + 4 * p ^ 2 * q ^ 2 + 4 * q ^ 3

/-- Rational points of E : y^2 = x^3 + 4x^2 - 16x + 16. -/
def A178612_onE (x y : ℚ) : Prop := y ^ 2 = x ^ 3 + 4 * x ^ 2 - 16 * x + 16

theorem A178612_toE (p q y : ℤ) (hp : p ≠ 0) (h : A178612_F p q = y ^ 2) :
    A178612_onE (4 * q / p ^ 2) (4 * y / p ^ 3) := by
  unfold A178612_onE
  unfold A178612_F at h
  have h' : ((p : ℚ) ^ 6 - 4 * p ^ 4 * q + 4 * p ^ 2 * q ^ 2 + 4 * q ^ 3) = (y : ℚ) ^ 2 := by
    exact_mod_cast h
  have hp' : (p : ℚ) ≠ 0 := by exact_mod_cast hp
  have e1 : (4 * (y : ℚ) / p ^ 3) ^ 2 = 16 * (y : ℚ) ^ 2 / p ^ 6 := by ring
  have e2 : (4 * (q : ℚ) / p ^ 2) ^ 3 + 4 * (4 * (q : ℚ) / p ^ 2) ^ 2 - 16 * (4 * (q : ℚ) / p ^ 2) + 16 =
      16 * ((p : ℚ) ^ 6 - 4 * p ^ 4 * q + 4 * p ^ 2 * q ^ 2 + 4 * q ^ 3) / p ^ 6 := by
    field_simp; ring
  rw [e1, e2, h']

/-- Main theorem (conditional on `hE`, the Mordell-Weil fact E(Q) = {O, (0, ±4)}): for p q ≠ 0, F(p,q) is not
a perfect square; in particular no term of A178612 is a square. -/
theorem A178612_no_square (hE : ∀ x y : ℚ, A178612_onE x y → x = 0) (p q : ℤ) (hp : p ≠ 0)
    (hq : q ≠ 0) : ¬ IsSquare (A178612_F p q) := by
  rintro ⟨y, hy⟩
  have h0 := hE _ _ (A178612_toE p q y hp (by rw [hy]; ring))
  have hp' : (p : ℚ) ^ 2 ≠ 0 := by positivity
  rw [div_eq_zero_iff] at h0
  rcases h0 with h0 | h0
  · have : (q : ℚ) = 0 := by linarith
    exact hq (by exact_mod_cast this)
  · exact hp' h0
