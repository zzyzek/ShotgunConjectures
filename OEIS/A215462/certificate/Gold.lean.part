import Mathlib.NumberTheory.Chebyshev

-- ===== our part: Goldbach representations and OEIS A215462, conjecture 2 =====

noncomputable section

open Finset
open scoped Pointwise

/-! ### Goldbach count and the shift `h' = 2n (P - 1)`

For `m < 2n` and a prime `q ∣ P = primorial Y`, `q ∣ m + h'` iff `q ∣ 2n - m`, so the
pair sieve on `m (m + h')` sifts the Goldbach sequence `m (2n - m)`. -/

/-- `goldCount n = #{m < 2n : m and 2n - m prime}`. -/
def goldCount (n : ℕ) : ℕ :=
  ((range (2 * n)).filter (fun m => m.Prime ∧ (2 * n - m).Prime)).card

/-- The shift `2n (primorial Y - 1)`. -/
def goldShift (n Y : ℕ) : ℕ := 2 * n * (primorial Y - 1)

theorem goldShift_even (n Y : ℕ) : 2 ∣ goldShift n Y :=
  Dvd.dvd.mul_right (dvd_mul_right 2 n) _

theorem goldShift_add (n Y : ℕ) : goldShift n Y + 2 * n = 2 * n * primorial Y := by
  have hP : 1 ≤ primorial Y := primorial_pos Y
  unfold goldShift
  rw [← Nat.mul_succ]
  congr 1
  omega

theorem prime_dvd_goldShift {n Y q : ℕ} (hqY : q ∣ primorial Y) :
    q ∣ goldShift n Y ↔ q ∣ 2 * n := by
  constructor
  · intro hd
    have e := goldShift_add n Y
    have h2 : q ∣ goldShift n Y + 2 * n := by
      rw [e]
      exact Dvd.dvd.mul_left hqY _
    exact (Nat.dvd_add_right hd).mp h2
  · intro h
    exact Dvd.dvd.mul_right h _

theorem dvd_of_dvd_goldShift {n Y q m : ℕ} (hq : q.Prime) (hqY : q ∣ primorial Y)
    (hm : m < 2 * n) (hd : q ∣ m * (m + goldShift n Y)) : q ∣ m ∨ q ∣ 2 * n - m := by
  rcases (Nat.Prime.dvd_mul hq).mp hd with h | h
  · exact Or.inl h
  · right
    have e : m + goldShift n Y + (2 * n - m) = 2 * n * primorial Y := by
      rw [← goldShift_add n Y]
      omega
    have h2 : q ∣ m + goldShift n Y + (2 * n - m) := by
      rw [e]
      exact Dvd.dvd.mul_left hqY _
    exact (Nat.dvd_add_right h).mp h2

theorem goldCount_le_sifted (n Y : ℕ) :
    goldCount n ≤ 2 * (Y + 1) + ((range (2 * n)).filter
      (fun m => Nat.Coprime (primorial Y) (m * (m + goldShift n Y)))).card := by
  have small : ∀ q m, q.Prime → q ∣ primorial Y → m.Prime → q ∣ m → m ≤ Y := by
    intro q m hq hqY hm hqm
    have h1 := (Sieve.prime_dvd_primorial_iff Y q hq).mp hqY
    have h2 := (Nat.prime_dvd_prime_iff_eq hq hm).mp hqm
    omega
  have hB : ((range (2 * n)).filter (fun m => 2 * n - m ≤ Y)).card ≤ Y + 1 := by
    calc _ ≤ ((range (Y + 1)).image (fun k => 2 * n - k)).card := by
          apply card_le_card
          intro m hm
          rw [mem_filter, mem_range] at hm
          rw [mem_image]
          exact ⟨2 * n - m, by rw [mem_range]; omega, by omega⟩
      _ ≤ (range (Y + 1)).card := card_image_le
      _ = Y + 1 := card_range _
  unfold goldCount
  calc _ ≤ ((range (Y + 1)) ∪ ((range (2 * n)).filter (fun m => 2 * n - m ≤ Y)) ∪
        (range (2 * n)).filter
          (fun m => Nat.Coprime (primorial Y) (m * (m + goldShift n Y)))).card := by
        apply card_le_card
        intro m hm
        simp only [mem_filter, mem_range] at hm
        rw [mem_union, mem_union]
        by_cases hmY : m ≤ Y
        · left; left
          rw [mem_range]
          omega
        by_cases hmY' : 2 * n - m ≤ Y
        · left; right
          rw [mem_filter, mem_range]
          exact ⟨hm.1, hmY'⟩
        right
        rw [mem_filter, mem_range]
        refine ⟨hm.1, Nat.coprime_of_dvd fun q hq hqY hqd => ?_⟩
        rcases dvd_of_dvd_goldShift hq hqY hm.1 hqd with h | h
        · exact hmY (small q m hq hqY hm.2.1 h)
        · exact hmY' (small q _ hq hqY hm.2.2 h)
    _ ≤ ((range (Y + 1)) ∪ ((range (2 * n)).filter (fun m => 2 * n - m ≤ Y))).card + _ :=
        card_union_le _ _
    _ ≤ (range (Y + 1)).card + ((range (2 * n)).filter (fun m => 2 * n - m ≤ Y)).card + _ := by
        gcongr
        exact card_union_le _ _
    _ ≤ _ := by
        rw [card_range]
        omega

/-! ### The minorant `f(p) = 2/p` for `p ∤ c`, `f(p) = 1/p` for `p ∣ c`

`goldG c m = ∏_{p^k ∥ m, p ∤ c} 2^k`, completely multiplicative, and `goldF c m = goldG c m / m`. -/

def goldG (c m : ℕ) : ℕ := m.factorization.prod (fun p k => if p ∣ c then 1 else 2 ^ k)

theorem goldG_mul (c : ℕ) {a b : ℕ} (ha : a ≠ 0) (hb : b ≠ 0) :
    goldG c (a * b) = goldG c a * goldG c b := by
  unfold goldG
  rw [Nat.factorization_mul ha hb, Finsupp.prod_add_index']
  · intro p
    simp
  · intro p k1 k2
    split_ifs <;> simp [pow_add]

theorem goldG_one (c : ℕ) : goldG c 1 = 1 := by
  simp [goldG]

theorem goldG_prime (c : ℕ) {p : ℕ} (hp : p.Prime) : goldG c p = if p ∣ c then 1 else 2 := by
  unfold goldG
  rw [hp.factorization, Finsupp.prod_single_index]
  · simp
  · simp

/-- The divisors of `m` coprime to `c` number at most `goldG c m`. -/
theorem card_coprime_divisors_le (c m : ℕ) (hm : m ≠ 0) :
    (m.divisors.filter (fun a => a.Coprime c)).card ≤ goldG c m := by
  induction m using Nat.recOnMul with
  | zero => exact absurd rfl hm
  | one =>
    rw [Nat.divisors_one, goldG_one]
    exact (card_filter_le _ _).trans (card_singleton 1).le
  | prime p hp =>
    rw [goldG_prime c hp, Nat.Prime.divisors hp]
    split_ifs with hpc
    · calc _ ≤ ({1} : Finset ℕ).card := by
            apply card_le_card
            intro a ha
            simp only [mem_filter, mem_insert, mem_singleton] at ha
            rcases ha with ⟨rfl | rfl, hac⟩
            · simp
            · exact absurd hpc ((Nat.Prime.coprime_iff_not_dvd hp).mp hac)
        _ = 1 := card_singleton 1
    · exact (card_filter_le _ _).trans (card_pair hp.one_lt.ne).le
  | mul a b iha ihb =>
    have ha : a ≠ 0 := left_ne_zero_of_mul hm
    have hb : b ≠ 0 := right_ne_zero_of_mul hm
    rw [goldG_mul c ha hb, Nat.divisors_mul]
    calc _ ≤ ((a.divisors.filter (fun d => d.Coprime c)) *
          (b.divisors.filter (fun d => d.Coprime c))).card := by
          apply card_le_card
          intro d hd
          rw [mem_filter, Finset.mem_mul] at hd
          obtain ⟨⟨x, hx, y, hy, rfl⟩, hc⟩ := hd
          rw [Finset.mem_mul]
          exact ⟨x, mem_filter.mpr ⟨hx, Nat.Coprime.coprime_dvd_left (dvd_mul_right x y) hc⟩,
            y, mem_filter.mpr ⟨hy, Nat.Coprime.coprime_dvd_left (dvd_mul_left y x) hc⟩, rfl⟩
      _ ≤ _ := Finset.card_mul_le.trans (Nat.mul_le_mul (iha ha) (ihb hb))

def goldF (c : ℕ) : ArithmeticFunction ℝ := ⟨fun m => (goldG c m : ℝ) / m, by simp⟩

theorem goldF_apply (c m : ℕ) : goldF c m = (goldG c m : ℝ) / m := rfl

theorem goldF_compMult (c : ℕ) : Sieve.CompletelyMultiplicative (goldF c) := by
  refine ⟨by simp [goldF_apply, goldG_one], fun a b => ?_⟩
  by_cases ha : a = 0
  · simp [goldF_apply, ha]
  by_cases hb : b = 0
  · simp [goldF_apply, hb]
  rw [goldF_apply, goldF_apply, goldF_apply, goldG_mul c ha hb]
  push_cast
  rw [mul_div_mul_comm]

theorem goldF_nonneg (c m : ℕ) : 0 ≤ goldF c m := by
  rw [goldF_apply]
  positivity

theorem goldF_prime_lt_one {c p : ℕ} (hc : 2 ∣ c) (hp : p.Prime) : goldF c p < 1 := by
  rw [goldF_apply, goldG_prime c hp]
  have h2 := hp.two_le
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.pos
  split_ifs with hpc
  · rw [div_lt_one hp0]
    exact_mod_cast hp.one_lt
  · have hp2 : p ≠ 2 := by
      rintro rfl
      exact hpc hc
    have h3 : (3 : ℝ) ≤ p := by exact_mod_cast (show 3 ≤ p by omega)
    rw [div_lt_one hp0]
    push_cast
    linarith

theorem goldF_prime_le_nu {n Y p : ℕ} (hp : p.Prime) (hpP : p ∣ primorial Y) :
    goldF (2 * n) p ≤ pairNu (goldShift n Y) p := by
  rw [goldF_apply, goldG_prime _ hp, pairNu_apply]
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.pos
  apply div_le_div_of_nonneg_right _ hp0.le
  split_ifs with hpc
  · exact_mod_cast pairRho_pos _ p hp.ne_zero
  · have hnd : ¬ p ∣ goldShift n Y := fun h => hpc ((prime_dvd_goldShift hpP).mp h)
    exact_mod_cast pairRho_prime_of_not_dvd hp hnd

/-! ### Main term: `S ≥ log(w+1)^2 / K(2n)` -/

/-- Factorisations `m = a b` with `a` coprime to `c`. -/
def coprimeAntidiag (c m : ℕ) : Finset (ℕ × ℕ) :=
  (m.divisorsAntidiagonal).filter (fun x => x.1.Coprime c)

theorem goldF_ge_sum (c m : ℕ) (hm : m ≠ 0) :
    ∑ x ∈ coprimeAntidiag c m, ((x.1 : ℝ) * x.2)⁻¹ ≤ goldF c m := by
  have hconst : ∀ x ∈ coprimeAntidiag c m, ((x.1 : ℝ) * x.2)⁻¹ = (m : ℝ)⁻¹ := by
    intro x hx
    rw [coprimeAntidiag, mem_filter, Nat.mem_divisorsAntidiagonal] at hx
    rw [← hx.1.1, Nat.cast_mul]
  have hcard : (coprimeAntidiag c m).card ≤ goldG c m := by
    refine le_trans ?_ (card_coprime_divisors_le c m hm)
    apply card_le_card_of_injOn Prod.fst
    · intro x hx
      simp only [coprimeAntidiag, coe_filter, Set.mem_ofPred_eq,
        Nat.mem_divisorsAntidiagonal, Nat.mem_divisors] at hx ⊢
      exact ⟨⟨Dvd.intro _ hx.1.1, hm⟩, hx.2⟩
    · intro x hx y hy hxy
      simp only [coprimeAntidiag, coe_filter, Set.mem_ofPred_eq,
        Nat.mem_divisorsAntidiagonal] at hx hy
      have hx0 : x.1 ≠ 0 := by
        rintro h
        rw [h, zero_mul] at hx
        exact hm hx.1.1.symm
      have e : x.1 * x.2 = x.1 * y.2 := by
        rw [hx.1.1]
        rw [hxy]
        exact hy.1.1.symm
      exact Prod.ext hxy (Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hx0) e)
  rw [sum_congr rfl hconst, sum_const, nsmul_eq_mul, goldF_apply, div_eq_mul_inv]
  gcongr

theorem sum_goldF_ge (c w : ℕ) :
    (∑ a ∈ (Icc 1 w).filter (fun a => a.Coprime c), ((a : ℕ) : ℝ)⁻¹) *
      (∑ b ∈ Icc 1 w, ((b : ℕ) : ℝ)⁻¹) ≤ ∑ m ∈ Icc 1 (w ^ 2), goldF c m := by
  set A := (Icc 1 w).filter (fun a => a.Coprime c) with hAdef
  rw [sum_mul_sum]
  calc ∑ a ∈ A, ∑ b ∈ Icc 1 w, ((a : ℕ) : ℝ)⁻¹ * ((b : ℕ) : ℝ)⁻¹
      = ∑ x ∈ A ×ˢ Icc 1 w, ((x.1 : ℝ) * x.2)⁻¹ := by
        rw [sum_product]
        refine sum_congr rfl (fun a _ => sum_congr rfl (fun b _ => ?_))
        rw [mul_inv]
    _ ≤ ∑ x ∈ (Icc 1 (w ^ 2)).biUnion (coprimeAntidiag c), ((x.1 : ℝ) * x.2)⁻¹ := by
        apply sum_le_sum_of_subset_of_nonneg
        · rintro ⟨a, b⟩ hx
          simp only [hAdef, mem_product, mem_filter, mem_Icc] at hx
          obtain ⟨⟨⟨ha1, ha2⟩, hac⟩, ⟨hb1, hb2⟩⟩ := hx
          rw [mem_biUnion]
          refine ⟨a * b, ?_, ?_⟩
          · rw [mem_Icc]
            refine ⟨Nat.mul_pos (by omega) (by omega), ?_⟩
            rw [sq]
            exact Nat.mul_le_mul ha2 hb2
          · rw [coprimeAntidiag, mem_filter, Nat.mem_divisorsAntidiagonal]
            exact ⟨⟨rfl, Nat.mul_ne_zero (by omega) (by omega)⟩, hac⟩
        · intro _ _ _
          positivity
    _ = ∑ m ∈ Icc 1 (w ^ 2), ∑ x ∈ coprimeAntidiag c m, ((x.1 : ℝ) * x.2)⁻¹ := by
        rw [sum_biUnion]
        intro m _ m' _ hne
        simp only [Function.onFun]
        rw [Finset.disjoint_left]
        intro x hx hx'
        rw [coprimeAntidiag, mem_filter, Nat.mem_divisorsAntidiagonal] at hx hx'
        exact hne (hx.1.1.symm.trans hx'.1.1)
    _ ≤ ∑ m ∈ Icc 1 (w ^ 2), goldF c m := by
        apply sum_le_sum
        intro m hm
        rw [mem_Icc] at hm
        exact goldF_ge_sum c m (by omega)

theorem goldSieve_boundingSum_ge (n w : ℕ) (hn : 0 < n) (hY : 1 ≤ w ^ 4) :
    Real.log ((w : ℝ) + 1) ^ 2 / pairK (2 * n) ≤
      (pairSieve (goldShift n (w ^ 4)) (2 * n) (w ^ 4) (goldShift_even n _) hY).selbergBoundingSum := by
  set s := pairSieve (goldShift n (w ^ 4)) (2 * n) (w ^ 4) (goldShift_even n _) hY with hs
  have hsqrt : Real.sqrt s.level = ((w ^ 2 : ℕ) : ℝ) := by
    show Real.sqrt ((w ^ 4 : ℕ) : ℝ) = _
    rw [show ((w ^ 4 : ℕ) : ℝ) = ((w ^ 2 : ℕ) : ℝ) ^ 2 by push_cast; ring]
    exact Real.sqrt_sq (Nat.cast_nonneg _)
  have hfloor : Nat.floor (Real.sqrt s.level) = w ^ 2 := by
    rw [hsqrt, Nat.floor_natCast]
  have hP : ∀ p : ℕ, p.Prime → (p : ℝ) ≤ s.level → p ∣ s.prodPrimes := by
    intro p hp hle
    have hle' : (p : ℝ) ≤ ((w ^ 4 : ℕ) : ℝ) := hle
    exact (Sieve.prime_dvd_primorial_iff _ p hp).mpr (by exact_mod_cast hle')
  have hb := pair_boundingSum_ge s (goldF (2 * n)) hP (goldF_compMult _) (goldF_nonneg _)
    (fun p hp _ => goldF_prime_lt_one (dvd_mul_right 2 n) hp)
    (fun p hp hpP => goldF_prime_le_nu hp hpP)
  rw [hfloor] at hb
  have hsum := sum_goldF_ge (2 * n) w
  have hlog := log_le_K_mul_coprimeHarm (2 * n) w (by omega)
  have hH : Real.log ((w : ℝ) + 1) ≤ ∑ b ∈ Icc 1 w, ((b : ℕ) : ℝ)⁻¹ := by
    have hH := log_add_one_le_harmonic w
    rw [harmonic_eq_sum_Icc] at hH
    push_cast at hH
    exact hH
  have hlog0 : 0 ≤ Real.log ((w : ℝ) + 1) :=
    Real.log_nonneg (by linarith [(Nat.cast_nonneg w : (0 : ℝ) ≤ w)])
  have hK := pairK_pos (2 * n)
  calc Real.log ((w : ℝ) + 1) ^ 2 / pairK (2 * n)
      = (Real.log ((w : ℝ) + 1) / pairK (2 * n)) * Real.log ((w : ℝ) + 1) := by ring
    _ ≤ (∑ a ∈ (Icc 1 w).filter (fun a => a.Coprime (2 * n)), ((a : ℕ) : ℝ)⁻¹) *
          (∑ b ∈ Icc 1 w, ((b : ℕ) : ℝ)⁻¹) :=
        mul_le_mul hlog hH hlog0 (sum_nonneg fun _ _ => by positivity)
    _ ≤ _ := hsum
    _ ≤ _ := hb

/-- **Selberg upper bound for Goldbach representations.** For `n > 0` and `w ≥ 1`,
`#{m < 2n : m, 2n - m prime} ≤ 2 (w^4 + 1) + K(2n) · 2n / log(w+1)^2 + w^16`,
with `K(c) = ∏_{p ∣ c} p/(p-1)` (one factor `K`, not `K^2`). -/
theorem goldCount_le_uniform (n w : ℕ) (hn : 0 < n) (hw : 1 ≤ w) :
    (goldCount n : ℝ) ≤ 2 * ((w : ℝ) ^ 4 + 1) +
      pairK (2 * n) * (2 * n) / Real.log ((w : ℝ) + 1) ^ 2 + (w : ℝ) ^ 16 := by
  have hY : 1 ≤ w ^ 4 := Nat.one_le_pow _ _ hw
  set h' := goldShift n (w ^ 4) with hh'
  set s := pairSieve h' (2 * n) (w ^ 4) (goldShift_even n _) hY with hs
  have h1 := goldCount_le_sifted n (w ^ 4)
  rw [← hh'] at h1
  have h1' : (goldCount n : ℝ) ≤ 2 * (((w ^ 4 : ℕ) : ℝ) + 1) +
      (((range (2 * n)).filter (fun m => Nat.Coprime (primorial (w ^ 4)) (m * (m + h')))).card
        : ℝ) := by exact_mod_cast h1
  have h2 := SelbergSieve.selberg_bound_simple s
  rw [hs, pairSieve_siftedSum] at h2
  have h3 := pairSieve_errSum_le h' (2 * n) (w ^ 4) (goldShift_even n _) hY
  have h4 := goldSieve_boundingSum_ge n w hn hY
  have hw1 : (1 : ℝ) ≤ w := by exact_mod_cast hw
  have hlogpos : 0 < Real.log ((w : ℝ) + 1) := Real.log_pos (by linarith)
  have hK := pairK_pos (2 * n)
  have hL : 0 < Real.log ((w : ℝ) + 1) ^ 2 / pairK (2 * n) := by positivity
  have h5 : ((2 * n : ℕ) : ℝ) / (pairSieve h' (2 * n) (w ^ 4) (goldShift_even n _) hY).selbergBoundingSum
      ≤ ((2 * n : ℕ) : ℝ) / (Real.log ((w : ℝ) + 1) ^ 2 / pairK (2 * n)) :=
    div_le_div_of_nonneg_left (Nat.cast_nonneg _) hL h4
  have h6 : ((2 * n : ℕ) : ℝ) / (Real.log ((w : ℝ) + 1) ^ 2 / pairK (2 * n)) =
      pairK (2 * n) * (2 * n) / Real.log ((w : ℝ) + 1) ^ 2 := by
    push_cast
    field_simp
  have hcast : ((w ^ 4 : ℕ) : ℝ) = (w : ℝ) ^ 4 := by push_cast; ring
  have hcast' : (((w ^ 4 : ℕ) : ℝ)) ^ 4 = (w : ℝ) ^ 16 := by
    rw [hcast]; ring
  have h2' : (((range (2 * n)).filter (fun m => Nat.Coprime (primorial (w ^ 4)) (m * (m + h')))).card
        : ℝ) ≤ ((2 * n : ℕ) : ℝ) / (pairSieve h' (2 * n) (w ^ 4) (goldShift_even n _) hY).selbergBoundingSum +
          ((w ^ 4 : ℕ) : ℝ) ^ 4 := by
    refine h2.trans ?_
    exact add_le_add (le_refl _) h3
  rw [hcast] at h1'
  rw [hcast'] at h2'
  linarith

/-! ### `K(c)^2 ≤ 4 (2 ω(c) + 1)` -/

theorem odd_prod_le (S : Finset ℕ) (hS : ∀ x ∈ S, x % 2 = 1 ∧ 3 ≤ x) :
    ∏ x ∈ S, ((x : ℝ) / ((x : ℝ) - 2)) ≤ 2 * S.card + 1 := by
  induction S using Finset.induction_on_max with
  | empty => simp
  | insert a S ha ih =>
    have haS : a ∉ S := fun h => lt_irrefl a (ha a h)
    have ih' := ih (fun x hx => hS x (mem_insert_of_mem hx))
    have ha3 := hS a (mem_insert_self a S)
    have hcard : 2 * S.card + 3 ≤ a := by
      have hsub : S ⊆ (range ((a - 3) / 2)).image (fun i => 2 * i + 3) := by
        intro x hx
        have hx1 := hS x (mem_insert_of_mem hx)
        have hx2 := ha x hx
        rw [mem_image]
        exact ⟨(x - 3) / 2, by rw [mem_range]; omega, by omega⟩
      have := (card_le_card hsub).trans card_image_le
      rw [card_range] at this
      omega
    rw [prod_insert haS, card_insert_of_notMem haS]
    have ha' : 2 * (S.card : ℝ) + 3 ≤ a := by exact_mod_cast hcard
    have hpos : (0 : ℝ) < (a : ℝ) - 2 := by
      have : (0 : ℝ) ≤ S.card := Nat.cast_nonneg _
      linarith
    have hk : (0 : ℝ) ≤ S.card := Nat.cast_nonneg _
    calc (a : ℝ) / ((a : ℝ) - 2) * ∏ x ∈ S, ((x : ℝ) / ((x : ℝ) - 2))
        ≤ (a : ℝ) / ((a : ℝ) - 2) * (2 * S.card + 1) :=
          mul_le_mul_of_nonneg_left ih' (div_nonneg (by linarith) hpos.le)
      _ ≤ 2 * ((S.card + 1 : ℕ) : ℝ) + 1 := by
          rw [div_mul_eq_mul_div, div_le_iff₀ hpos]
          push_cast
          nlinarith

theorem pairK_sq_le (c : ℕ) : pairK c ^ 2 ≤ 4 * (2 * (c.primeFactors.card : ℝ) + 1) := by
  unfold pairK
  rw [← prod_pow]
  set S := c.primeFactors with hSdef
  have hS : ∀ p ∈ S, p.Prime := fun p hp => Nat.prime_of_mem_primeFactors hp
  rw [← prod_filter_mul_prod_filter_not S (fun p => p = 2)]
  have hnn : ∀ p : ℕ, 0 ≤ ((1 - (p : ℝ)⁻¹)⁻¹) ^ 2 := fun p => sq_nonneg _
  have h1 : ∏ p ∈ S.filter (fun p => p = 2), ((1 - (p : ℝ)⁻¹)⁻¹) ^ 2 ≤ 4 := by
    have hsub : S.filter (fun p => p = 2) ⊆ {2} := by
      intro p hp
      rw [mem_filter] at hp
      rw [mem_singleton]
      exact hp.2
    rcases Finset.subset_singleton_iff.mp hsub with h | h
    · rw [h, prod_empty]
      norm_num
    · rw [h, prod_singleton]
      norm_num
  have h2 : ∏ p ∈ S.filter (fun p => ¬ p = 2), ((1 - (p : ℝ)⁻¹)⁻¹) ^ 2 ≤
      2 * (S.filter (fun p => ¬ p = 2)).card + 1 := by
    refine le_trans (prod_le_prod₀ (fun p _ => hnn p) (fun p hp => ?_)) (odd_prod_le _ ?_)
    · rw [mem_filter] at hp
      have hp' := hS p hp.1
      have h3n : 3 ≤ p := by
        have := hp'.two_le
        omega
      have h3 : (3 : ℝ) ≤ p := by exact_mod_cast h3n
      have hp0 : (p : ℝ) ≠ 0 := by positivity
      have hp1 : (p : ℝ) - 1 ≠ 0 := by
        intro h
        linarith
      have e : (1 - (p : ℝ)⁻¹)⁻¹ = p / (p - 1) := by
        field_simp
      rw [e, div_pow, div_le_div_iff₀ (by positivity) (by linarith)]
      nlinarith
    · intro x hx
      rw [mem_filter] at hx
      have hx' := hS x hx.1
      rcases hx'.eq_two_or_odd with h | h
      · exact absurd h hx.2
      · have := hx'.two_le
        exact ⟨h, by omega⟩
  have hcard : ((S.filter (fun p => ¬ p = 2)).card : ℝ) ≤ S.card := by
    exact_mod_cast card_filter_le _ _
  have hp2 : 0 ≤ ∏ p ∈ S.filter (fun p => ¬ p = 2), ((1 - (p : ℝ)⁻¹)⁻¹) ^ 2 :=
    prod_nonneg (fun p _ => hnn p)
  calc _ ≤ 4 * (2 * ((S.filter (fun p => ¬ p = 2)).card : ℝ) + 1) :=
        mul_le_mul h1 h2 hp2 (by norm_num)
    _ ≤ _ := by linarith

theorem two_pow_card_primeFactors_le (c : ℕ) (hc : c ≠ 0) : 2 ^ c.primeFactors.card ≤ c := by
  calc 2 ^ c.primeFactors.card = ∏ _p ∈ c.primeFactors, 2 := (prod_const 2).symm
    _ ≤ ∏ p ∈ c.primeFactors, p :=
        prod_le_prod (fun p hp => (Nat.prime_of_mem_primeFactors hp).two_le)
    _ ≤ c := Nat.le_of_dvd (Nat.pos_of_ne_zero hc) (Nat.prod_primeFactors_dvd c)

/-! ### OEIS A215462, A215461, A002372

All three count the `n` ordered pairs `(2i+1, 2j+1)`, `i + j = n - 1`, of odd numbers with sum `2n`:
both nonprime (A215462, 1 counts as nonprime), exactly one prime (A215461), both prime (A002372). -/

def A215462 (n : ℕ) : ℕ :=
  ((range n).filter (fun i => ¬ (2 * i + 1).Prime ∧ ¬ (2 * (n - 1 - i) + 1).Prime)).card

def A215461 (n : ℕ) : ℕ :=
  ((range n).filter (fun i => ((2 * i + 1).Prime ∧ ¬ (2 * (n - 1 - i) + 1).Prime) ∨
    (¬ (2 * i + 1).Prime ∧ (2 * (n - 1 - i) + 1).Prime))).card

def A002372 (n : ℕ) : ℕ :=
  ((range n).filter (fun i => (2 * i + 1).Prime ∧ (2 * (n - 1 - i) + 1).Prime)).card

theorem A215462_counts (n : ℕ) :
    n ≤ A215462 n + 2 * Nat.primeCounting (2 * n) ∧
    A215461 n ≤ 2 * Nat.primeCounting (2 * n) ∧
    Nat.primeCounting (2 * n) ≤ A215461 n + A002372 n + 1 ∧
    A002372 n ≤ goldCount n := by
  set PL := (range n).filter (fun i => (2 * i + 1).Prime) with hPLdef
  set PR := (range n).filter (fun i => (2 * (n - 1 - i) + 1).Prime) with hPRdef
  have hpi : (Nat.primesLE (2 * n)).card = Nat.primeCounting (2 * n) :=
    Nat.primesLE_card_eq_primeCounting _
  have hPL : PL.card ≤ Nat.primeCounting (2 * n) := by
    rw [← hpi]
    apply card_le_card_of_injOn (fun i => 2 * i + 1)
    · intro i hi
      simp only [hPLdef, coe_filter, Set.mem_ofPred_eq, mem_coe, mem_range,
        Nat.mem_primesLE] at hi ⊢
      exact ⟨by omega, hi.2⟩
    · intro i _ j _ e
      simp only at e
      omega
  have hPR : PR.card ≤ Nat.primeCounting (2 * n) := by
    rw [← hpi]
    apply card_le_card_of_injOn (fun i => 2 * (n - 1 - i) + 1)
    · intro i hi
      simp only [hPRdef, coe_filter, Set.mem_ofPred_eq, mem_coe, mem_range,
        Nat.mem_primesLE] at hi ⊢
      exact ⟨by omega, hi.2⟩
    · intro i hi j hj e
      simp only [hPRdef, coe_filter, Set.mem_ofPred_eq, mem_range] at hi hj e
      omega
  have hPL' : Nat.primeCounting (2 * n) ≤ PL.card + 1 := by
    rw [← hpi]
    calc _ ≤ (insert 2 (PL.image (fun i => 2 * i + 1))).card := by
          apply card_le_card
          intro p hp
          rw [Nat.mem_primesLE] at hp
          rw [mem_insert, mem_image]
          rcases hp.2.eq_two_or_odd with h | h
          · exact Or.inl h
          · right
            refine ⟨p / 2, ?_, by omega⟩
            rw [hPLdef, mem_filter, mem_range]
            refine ⟨by omega, ?_⟩
            rw [show 2 * (p / 2) + 1 = p by omega]
            exact hp.2
      _ ≤ (PL.image (fun i => 2 * i + 1)).card + 1 := card_insert_le _ _
      _ ≤ PL.card + 1 := by
          have := card_image_le (s := PL) (f := fun i => 2 * i + 1)
          omega
  have ha : n ≤ A215462 n + PL.card + PR.card := by
    unfold A215462
    calc n = (range n).card := (card_range n).symm
      _ ≤ (((range n).filter (fun i => ¬ (2 * i + 1).Prime ∧ ¬ (2 * (n - 1 - i) + 1).Prime))
            ∪ PL ∪ PR).card := by
          apply card_le_card
          intro i hi
          rw [mem_union, mem_union, mem_filter, hPLdef, hPRdef, mem_filter, mem_filter]
          by_cases h1 : (2 * i + 1).Prime
          · exact Or.inl (Or.inr ⟨hi, h1⟩)
          by_cases h2 : (2 * (n - 1 - i) + 1).Prime
          · exact Or.inr ⟨hi, h2⟩
          exact Or.inl (Or.inl ⟨hi, h1, h2⟩)
      _ ≤ _ := by
          refine (card_union_le _ _).trans ?_
          have := card_union_le
            ((range n).filter (fun i => ¬ (2 * i + 1).Prime ∧ ¬ (2 * (n - 1 - i) + 1).Prime)) PL
          omega
  have hb : A215461 n ≤ PL.card + PR.card := by
    unfold A215461
    refine le_trans (card_le_card ?_) (card_union_le PL PR)
    intro i hi
    rw [mem_filter] at hi
    rw [mem_union, hPLdef, hPRdef, mem_filter, mem_filter]
    rcases hi.2 with h | h
    · exact Or.inl ⟨hi.1, h.1⟩
    · exact Or.inr ⟨hi.1, h.2⟩
  have hc : PL.card ≤ A215461 n + A002372 n := by
    unfold A215461 A002372
    refine le_trans (card_le_card ?_) (card_union_le _ _)
    intro i hi
    rw [hPLdef, mem_filter] at hi
    rw [mem_union, mem_filter, mem_filter]
    by_cases h2 : (2 * (n - 1 - i) + 1).Prime
    · exact Or.inr ⟨hi.1, hi.2, h2⟩
    · exact Or.inl ⟨hi.1, Or.inl ⟨hi.2, h2⟩⟩
  have hg : A002372 n ≤ goldCount n := by
    unfold A002372 goldCount
    apply card_le_card_of_injOn (fun i => 2 * i + 1)
    · intro i hi
      simp only [coe_filter, Set.mem_ofPred_eq, mem_range] at hi ⊢
      refine ⟨by omega, hi.2.1, ?_⟩
      rw [show 2 * n - (2 * i + 1) = 2 * (n - 1 - i) + 1 by omega]
      exact hi.2.2
    · intro i _ j _ e
      simp only at e
      omega
  refine ⟨by omega, by omega, by omega, hg⟩


/-! ### The asymptotic step

Take `j ≥ 5·10^7` with `2^(20 j) ≤ n < 2^(20 j + 20)` and `x = 2^j`. Chebyshev gives
`n ≤ 21 j π(2n)` and `4 π(2n) < n`; the sieve bound with `w = x` and `K(2n) ≤ j / 500`
gives `goldCount n ≤ n / (50 j)`. -/

theorem A215462_basic (n j : ℕ) (hj : 50000000 ≤ j) (hlo : 2 ^ (20 * j) ≤ n) :
    (j : ℝ) < (2 : ℝ) ^ j ∧ 1 ≤ (2 : ℝ) ^ j ∧ ((2 : ℝ) ^ j) ^ 20 ≤ n ∧
      500 * (j : ℝ) ≤ ((2 : ℝ) ^ j) ^ 4 ∧ 500 * (j : ℝ) * ((2 : ℝ) ^ j) ^ 16 ≤ n ∧
      500 * (j : ℝ) ≤ n := by
  obtain ⟨x, hx⟩ : ∃ x : ℝ, x = (2 : ℝ) ^ j := ⟨_, rfl⟩
  rw [← hx]
  have hjR : (50000000 : ℝ) ≤ j := by exact_mod_cast hj
  have hj0 : (0 : ℝ) < j := by linarith
  have hjx : (j : ℝ) < x := by
    rw [hx]
    exact_mod_cast Nat.lt_two_pow_self
  have hx1 : 1 ≤ x := by
    rw [hx]
    exact one_le_pow₀ (by norm_num)
  have hx20 : x ^ 20 ≤ n := by
    rw [hx, ← pow_mul, mul_comm]
    exact_mod_cast hlo
  have hx4 : 500 * (j : ℝ) ≤ x ^ 4 := by
    have h1 : (j : ℝ) ^ 4 ≤ x ^ 4 := pow_le_pow_left₀ hj0.le hjx.le 4
    have h2 : (1 : ℝ) ≤ (j : ℝ) ^ 2 := one_le_pow₀ (by linarith)
    have h3 : (j : ℝ) ^ 3 = j * (j : ℝ) ^ 2 := by ring
    have h4 : (j : ℝ) ≤ (j : ℝ) ^ 3 := by
      rw [h3]
      nlinarith
    have h5 : (j : ℝ) ^ 4 = j * (j : ℝ) ^ 3 := by ring
    have h6 : 500 * (j : ℝ) ≤ (j : ℝ) ^ 4 := by
      rw [h5]
      nlinarith
    linarith
  have hx16 : 1 ≤ x ^ 16 := one_le_pow₀ hx1
  have hnx : 500 * (j : ℝ) * x ^ 16 ≤ n := by
    have e : x ^ 20 = x ^ 4 * x ^ 16 := by ring
    have := mul_le_mul_of_nonneg_right hx4 (show (0 : ℝ) ≤ x ^ 16 by positivity)
    linarith
  have hnj : 500 * (j : ℝ) ≤ n := by
    have := mul_le_mul_of_nonneg_left hx16 (show (0 : ℝ) ≤ 500 * j by positivity)
    linarith
  exact ⟨hjx, hx1, hx20, hx4, hnx, hnj⟩

theorem log_two_bounds : (0.69 : ℝ) < Real.log 2 ∧ Real.log 2 < 0.7 := by
  have h1 := Real.log_two_gt_d9
  have h2 := Real.log_two_lt_d9
  constructor <;> linarith

/-- `20 j log 2 ≤ log n`. -/
theorem A215462_log_lo (n j : ℕ) (hj : 50000000 ≤ j) (hlo : 2 ^ (20 * j) ≤ n) :
    20 * j * Real.log 2 ≤ Real.log n := by
  obtain ⟨_, hx1, hx20, -⟩ := A215462_basic n j hj hlo
  have h := Real.log_le_log (by positivity) hx20
  rw [← pow_mul, Real.log_pow] at h
  push_cast at h
  linarith

/-- `log (2n + 1) ≤ (20 j + 21) log 2`. -/
theorem A215462_log_hi (n j : ℕ) (hhi : n < 2 ^ (20 * j + 20)) :
    Real.log (2 * n + 1) ≤ (20 * j + 21) * Real.log 2 := by
  have h1 : 2 * n + 1 ≤ 2 ^ (20 * j + 21) := by
    rw [pow_succ]
    omega
  have h2 : (2 * (n : ℝ) + 1) ≤ (2 : ℝ) ^ (20 * j + 21) := by exact_mod_cast h1
  have h3 := Real.log_le_log (by positivity) h2
  rw [Real.log_pow] at h3
  push_cast at h3
  exact h3

/-- Part A: `4 π(2n) < n` (Chebyshev upper bound). -/
theorem A215462_partA (n j : ℕ) (hj : 50000000 ≤ j) (hlo : 2 ^ (20 * j) ≤ n) :
    4 * Nat.primeCounting (2 * n) < n := by
  obtain ⟨-, -, -, -, -, hnj⟩ := A215462_basic n j hj hlo
  have hlog := A215462_log_lo n j hj hlo
  obtain ⟨hℓ1, -⟩ := log_two_bounds
  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : ℝ, ℓ = Real.log 2 := ⟨_, rfl⟩
  obtain ⟨nR, hnR⟩ : ∃ nR : ℝ, nR = n := ⟨_, rfl⟩
  rw [← hℓ, ← hnR] at hlog
  rw [← hℓ] at hℓ1
  rw [← hnR] at hnj
  have hjR : (50000000 : ℝ) ≤ j := by exact_mod_cast hj
  have hn0R : 0 ≤ nR := by linarith
  have hℓ0 : 0 < ℓ := by linarith
  have hm2 : ((2 * n : ℕ) : ℝ) = 2 * nR := by
    rw [hnR]
    push_cast
    ring
  have h2lo : 20 * j * ℓ ≤ Real.log (2 * nR) :=
    hlog.trans (Real.log_le_log (by linarith) (by linarith))
  obtain ⟨D, hD⟩ : ∃ D : ℝ, D = Real.log (2 * nR) := ⟨_, rfl⟩
  rw [← hD] at h2lo
  have h1 : (1 : ℝ) < ((2 * n : ℕ) : ℝ) := by
    rw [hm2]
    linarith
  have hpi := Chebyshev.pi_le_log4_mul_div h1
  rw [Nat.floor_natCast, Real.log_sqrt (by positivity), hm2, ← hD] at hpi
  have hlog4 : Real.log 4 = 2 * ℓ := by
    rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow, hℓ]
    push_cast
    ring
  rw [hlog4] at hpi
  have hD0 : 0 < D := by
    have : 0 < 20 * (j : ℝ) * ℓ := by positivity
    linarith
  have hfirst : 2 * ℓ * (2 * nR) / (D / 2) ≤ nR / 16 := by
    rw [div_le_iff₀ (by positivity)]
    have hA1 := mul_le_mul_of_nonneg_left h2lo hn0R
    have hA2 : 0 ≤ nR * ℓ * ((j : ℝ) - 7) :=
      mul_nonneg (mul_nonneg hn0R hℓ0.le) (by linarith)
    nlinarith
  have hsqrt : Real.sqrt (2 * nR) ≤ nR / 8 := by
    rw [show nR / 8 = Real.sqrt ((nR / 8) ^ 2) from (Real.sqrt_sq (by positivity)).symm]
    apply Real.sqrt_le_sqrt
    have := mul_le_mul_of_nonneg_left (show (128 : ℝ) ≤ nR by linarith) hn0R
    nlinarith
  have : ((4 * Nat.primeCounting (2 * n) : ℕ) : ℝ) < (n : ℝ) := by
    push_cast
    rw [← hnR]
    linarith
  exact_mod_cast this

/-- Part B: `n ≤ 21 j π(2n)` (Chebyshev lower bound). -/
theorem A215462_partB (n j : ℕ) (hj : 50000000 ≤ j) (hlo : 2 ^ (20 * j) ≤ n)
    (hhi : n < 2 ^ (20 * j + 20)) :
    (n : ℝ) ≤ (Nat.primeCounting (2 * n) : ℝ) * (21 * j) := by
  obtain ⟨-, -, -, -, -, hnj⟩ := A215462_basic n j hj hlo
  have hlog := A215462_log_lo n j hj hlo
  have hlog1 := A215462_log_hi n j hhi
  obtain ⟨hℓ1, -⟩ := log_two_bounds
  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : ℝ, ℓ = Real.log 2 := ⟨_, rfl⟩
  obtain ⟨nR, hnR⟩ : ∃ nR : ℝ, nR = n := ⟨_, rfl⟩
  rw [← hℓ, ← hnR] at hlog hlog1
  rw [← hℓ] at hℓ1
  rw [← hnR] at hnj ⊢
  have hjR : (50000000 : ℝ) ≤ j := by exact_mod_cast hj
  have hn0R : 0 ≤ nR := by linarith
  have hℓ0 : 0 < ℓ := by linarith
  have hm2 : ((2 * n : ℕ) : ℝ) = 2 * nR := by
    rw [hnR]
    push_cast
    ring
  have h2hi : Real.log (2 * nR) ≤ (20 * j + 21) * ℓ :=
    le_trans (Real.log_le_log (by linarith) (by linarith)) hlog1
  have h2lo : 20 * j * ℓ ≤ Real.log (2 * nR) :=
    hlog.trans (Real.log_le_log (by linarith) (by linarith))
  obtain ⟨D, hD⟩ : ∃ D : ℝ, D = Real.log (2 * nR) := ⟨_, rfl⟩
  rw [← hD] at h2lo h2hi
  have hD0 : 0 < D := by
    have : 0 < 20 * (j : ℝ) * ℓ := by positivity
    linarith
  have hpi0 : (0 : ℝ) ≤ Nat.primeCounting (2 * n) := Nat.cast_nonneg _
  have hpi := Chebyshev.pi_ge (2 * n)
  rw [hm2, ← hD, ← hℓ, div_le_iff₀ hD0] at hpi
  have hDle : D ≤ 21 * j * ℓ := by
    have : 0 ≤ ((j : ℝ) - 21) * ℓ := mul_nonneg (by linarith) hℓ0.le
    linarith
  have hnum : nR * ℓ ≤ 2 * nR * ℓ - Real.log (2 * nR + 1) := by
    have h1 : 20 * (j : ℝ) + 21 ≤ nR := by linarith
    have h2 := mul_le_mul_of_nonneg_right h1 hℓ0.le
    linarith
  have : nR * ℓ ≤ (Nat.primeCounting (2 * n) : ℝ) * (21 * j) * ℓ := by
    calc nR * ℓ ≤ _ := hnum
      _ ≤ (Nat.primeCounting (2 * n) : ℝ) * D := hpi
      _ ≤ (Nat.primeCounting (2 * n) : ℝ) * (21 * j * ℓ) :=
          mul_le_mul_of_nonneg_left hDle hpi0
      _ = _ := by ring
  exact le_of_mul_le_mul_right this hℓ0

/-- `K(2n) ≤ j / 500`, from `K^2 ≤ 4 (2 ω + 1)` and `2^ω ≤ 2n`. -/
theorem A215462_K (n j : ℕ) (hj : 50000000 ≤ j) (hn : 0 < n) (hhi : n < 2 ^ (20 * j + 20)) :
    pairK (2 * n) ≤ (j : ℝ) / 500 := by
  have hω : (2 * n).primeFactors.card ≤ 20 * j + 20 := by
    have h1 := two_pow_card_primeFactors_le (2 * n) (by omega)
    by_contra hc
    push Not at hc
    have : 2 ^ (20 * j + 21) ≤ 2 ^ (2 * n).primeFactors.card :=
      Nat.pow_le_pow_right (by norm_num) hc
    rw [pow_succ] at this
    omega
  have hωR : ((2 * n).primeFactors.card : ℝ) ≤ 20 * j + 20 := by exact_mod_cast hω
  have hjR : (50000000 : ℝ) ≤ j := by exact_mod_cast hj
  have hj0 : (0 : ℝ) < j := by linarith
  have hsq := pairK_sq_le (2 * n)
  have hKp := pairK_pos (2 * n)
  by_contra hc
  push Not at hc
  have h1 : ((j : ℝ) / 500) ^ 2 < pairK (2 * n) ^ 2 :=
    pow_lt_pow_left₀ hc (by positivity) (by norm_num)
  have h2 := mul_le_mul_of_nonneg_right hjR hj0.le
  have e : ((j : ℝ) / 500) ^ 2 = (j : ℝ) * j / 250000 := by ring
  linarith

/-- Part C: `goldCount n ≤ n / (50 j)` (Selberg sieve with `w = 2^j`). -/
theorem A215462_partC (n j : ℕ) (hj : 50000000 ≤ j) (hlo : 2 ^ (20 * j) ≤ n)
    (hK : pairK (2 * n) ≤ (j : ℝ) / 500) :
    (goldCount n : ℝ) ≤ n / (50 * j) := by
  obtain ⟨hjx, hx1, -, -, hnx, -⟩ := A215462_basic n j hj hlo
  have hn : 0 < n := lt_of_lt_of_le Nat.one_le_two_pow hlo
  have hc := goldCount_le_uniform n (2 ^ j) hn Nat.one_le_two_pow
  obtain ⟨hℓ1, -⟩ := log_two_bounds
  have hlogx : (j : ℝ) * Real.log 2 ≤ Real.log ((2 : ℝ) ^ j + 1) := by
    rw [← Real.log_pow]
    exact Real.log_le_log (by positivity) (by linarith)
  push_cast at hc
  obtain ⟨x, hx⟩ : ∃ x : ℝ, x = (2 : ℝ) ^ j := ⟨_, rfl⟩
  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : ℝ, ℓ = Real.log 2 := ⟨_, rfl⟩
  obtain ⟨nR, hnR⟩ : ∃ nR : ℝ, nR = n := ⟨_, rfl⟩
  rw [← hx] at hjx hx1 hnx hc hlogx
  rw [← hℓ] at hℓ1 hlogx
  rw [← hnR] at hnx hc ⊢
  have hjR : (50000000 : ℝ) ≤ j := by exact_mod_cast hj
  have hj0 : (0 : ℝ) < j := by linarith
  have hℓ0 : 0 < ℓ := by linarith
  have hn0R : 0 ≤ nR := by
    rw [hnR]
    exact Nat.cast_nonneg _
  have hjl : 0 < (j : ℝ) * ℓ := by positivity
  have hlsq : ((j : ℝ) * ℓ) ^ 2 ≤ Real.log (x + 1) ^ 2 := pow_le_pow_left₀ hjl.le hlogx 2
  have hKp := pairK_pos (2 * n)
  have hmid : pairK (2 * n) * (2 * nR) / Real.log (x + 1) ^ 2 ≤
      pairK (2 * n) * (2 * nR) / ((j : ℝ) * ℓ) ^ 2 :=
    div_le_div_of_nonneg_left (by positivity) (by positivity) hlsq
  have hmid2 : pairK (2 * n) * (2 * nR) / ((j : ℝ) * ℓ) ^ 2 ≤ nR / (100 * j) := by
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    have hℓsq : (0.4761 : ℝ) ≤ ℓ ^ 2 := by nlinarith
    have e1 : pairK (2 * n) * (2 * nR) * (100 * j) ≤ (j / 500) * (2 * nR) * (100 * j) := by
      gcongr
    have hnn : 0 ≤ nR * (j : ℝ) ^ 2 := by positivity
    have e2 := mul_le_mul_of_nonneg_left hℓsq hnn
    have e3 : nR * ((j : ℝ) * ℓ) ^ 2 = nR * (j : ℝ) ^ 2 * ℓ ^ 2 := by ring
    have e4 : (j / 500) * (2 * nR) * (100 * j) = 0.4 * (nR * (j : ℝ) ^ 2) := by ring
    nlinarith
  have hsmall : 2 * (x ^ 4 + 1) + x ^ 16 ≤ nR / (100 * j) := by
    rw [le_div_iff₀ (by positivity)]
    have p4 : x ^ 4 ≤ x ^ 16 := pow_le_pow_right₀ hx1 (by norm_num)
    have p0 : 1 ≤ x ^ 16 := one_le_pow₀ hx1
    have hq : 2 * (x ^ 4 + 1) + x ^ 16 ≤ 5 * x ^ 16 := by linarith
    have := mul_le_mul_of_nonneg_right hq (show (0 : ℝ) ≤ 100 * j by positivity)
    nlinarith
  have e : nR / (50 * j) = nR / (100 * j) + nR / (100 * j) := by
    field_simp
    ring
  linarith

theorem A215462_analytic (n J : ℕ) (hJ : 50000000 ≤ J) (hn : 2 ^ (20 * J) ≤ n) :
    4 * Nat.primeCounting (2 * n) < n ∧ 2 * goldCount n + 1 < Nat.primeCounting (2 * n) := by
  have hL : 20 * J ≤ Nat.log 2 n := Nat.le_log_of_pow_le (by norm_num) hn
  have hn0 : n ≠ 0 := by
    have := Nat.one_le_two_pow (n := 20 * J)
    omega
  have hNlt : n < 2 ^ (Nat.log 2 n + 1) := Nat.lt_pow_succ_log_self (by norm_num) n
  have hNge : 2 ^ Nat.log 2 n ≤ n := Nat.pow_log_le_self 2 hn0
  obtain ⟨j, hjdef⟩ : ∃ j, j = Nat.log 2 n / 20 := ⟨_, rfl⟩
  have hj : 50000000 ≤ j := by omega
  have hlo : 2 ^ (20 * j) ≤ n :=
    (Nat.pow_le_pow_right (by norm_num) (by omega)).trans hNge
  have hhi : n < 2 ^ (20 * j + 20) :=
    lt_of_lt_of_le hNlt (Nat.pow_le_pow_right (by norm_num) (by omega))
  refine ⟨A215462_partA n j hj hlo, ?_⟩
  have hB := A215462_partB n j hj hlo hhi
  have hG := A215462_partC n j hj hlo (A215462_K n j hj (by omega) hhi)
  obtain ⟨-, -, -, -, -, hnj⟩ := A215462_basic n j hj hlo
  have hjR : (50000000 : ℝ) ≤ j := by exact_mod_cast hj
  have hj0 : (0 : ℝ) < j := by linarith
  have hfin : ((2 * goldCount n + 1 : ℕ) : ℝ) < (Nat.primeCounting (2 * n) : ℝ) := by
    push_cast
    have h1 : 2 * (goldCount n : ℝ) * (21 * j) ≤ (n : ℝ) * 21 / 25 := by
      have := mul_le_mul_of_nonneg_right hG (show (0 : ℝ) ≤ 2 * (21 * j) by positivity)
      have e : (n : ℝ) / (50 * j) * (2 * (21 * j)) = (n : ℝ) * 21 / 25 := by
        field_simp
        ring
      linarith
    have e : (2 * (goldCount n : ℝ) + 1) * (21 * j) =
        2 * (goldCount n : ℝ) * (21 * j) + 21 * j := by
      ring
    have : (2 * (goldCount n : ℝ) + 1) * (21 * j) <
        (Nat.primeCounting (2 * n) : ℝ) * (21 * j) := by
      linarith
    exact lt_of_mul_lt_mul_right this (by positivity)
  exact_mod_cast hfin

/-- **OEIS A215462, conjecture 2**: `a(n) > A215461(n) > A002372(n)` for all sufficiently large
`n`; explicitly for every `n ≥ 2 ^ (20 · 5·10^7) = 2 ^ (10^9)`. -/
theorem A215462_conj2 :
    ∃ N0 : ℕ, ∀ n ≥ N0, A215461 n < A215462 n ∧ A002372 n < A215461 n := by
  obtain ⟨J, hJ⟩ : ∃ J : ℕ, J = 50000000 := ⟨_, rfl⟩
  refine ⟨2 ^ (20 * J), fun n hn => ?_⟩
  obtain ⟨ha, hb, hc, hg⟩ := A215462_counts n
  obtain ⟨h1, h2⟩ := A215462_analytic n J hJ.ge hn
  omega

end
